// Shapes shared by many moves.

/** One foe: a direct hit of the given power. */
fn single_hit(name: string, power: int, cooldown: int): MoveDef {
    fn strike(battle: Battle, user: Character, target: Target): List<Action> {
        match target {
            Target.Single(defender) => { return [hit(user, defender, power)]; }
            _ => { return []; }
        }
        return [];
    }
    return MoveDef { name: name, shape: TargetShape.SingleFoe, apply: strike, cooldown: cooldown, basic: false };
}

/** All foes: a direct hit of the given power on each. */
fn area_hit(name: string, power: int, cooldown: int): MoveDef {
    fn strike(battle: Battle, user: Character, target: Target): List<Action> {
        var out: List<Action> = [];
        match target {
            Target.Spread(defenders) => {
                for (d in defenders) { out.push(hit(user, d, power)); }
            }
            _ => {}
        }
        return out;
    }
    return MoveDef { name: name, shape: TargetShape.AllFoes, apply: strike, cooldown: cooldown, basic: false };
}

/** The user: a taunt for the given rounds. */
fn taunt_move(name: string, rounds: int, cooldown: int): MoveDef {
    fn roar(battle: Battle, user: Character, target: Target): List<Action> { return [Action.AddEffect(user, taunt(rounds))]; }
    return MoveDef { name: name, shape: TargetShape.User, apply: roar, cooldown: cooldown, basic: false };
}

// Barbarian. See docs/characters.md.

fn cleave_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(defender) => { return [hit(user, defender, cleave_power())]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: a direct hit. */
fn cleave(): MoveDef {
    return MoveDef { name: "Cleave", shape: TargetShape.SingleFoe, apply: cleave_apply, cooldown: cleave_cooldown(), basic: false };
}

// Paladin. See docs/characters.md.

fn smite_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        // Dispel first, so a shield or barrier is gone before the hit.
        Target.Single(defender) => { return [Action.Dispel(defender), hit(user, defender, smite_power())]; }
        _ => { return []; }
    }
    return [];
}

fn guard_apply(battle: Battle, user: Character, target: Target): List<Action> {
    return [Action.AddEffect(user, guarding_taunt(guard_rounds()))];
}

fn lay_on_hands_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(ally) => { return [Action.Heal(ally, lay_on_hands_heal()), Action.Heal(user, lay_on_hands_heal())]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: dispels its buffs, then a direct hit. */
fn smite(): MoveDef {
    return MoveDef { name: "Smite", shape: TargetShape.SingleFoe, apply: smite_apply, cooldown: smite_cooldown(), basic: false };
}

/** The user: taunt with defense up. */
fn guard(): MoveDef {
    return MoveDef { name: "Guard", shape: TargetShape.User, apply: guard_apply, cooldown: guard_cooldown(), basic: false };
