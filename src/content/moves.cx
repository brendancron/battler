// Monk. See docs/characters.md.

fn disarming_palm_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(defender) => {
            return [hit(user, defender, disarming_palm_power()), Action.AddEffect(defender, timed(attack_down(), disarming_palm_rounds())), Action.AddEffect(defender, timed(defense_down(), disarming_palm_rounds()))];
        }
        _ => { return []; }
    }
    return [];
}

fn crippling_blow_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(defender) => { return [hit(user, defender, crippling_blow_power()), Action.AddEffect(defender, heal_block(crippling_blow_turns()))]; }
        _ => { return []; }
    }
    return [];
}

/** One punch per pick. A foe's first punch is a hit; punches on a foe already punched are follow-ups. */
fn flurry_apply(battle: Battle, user: Character, target: Target): List<Action> {
    var out: List<Action> = [];
    var punched: List<Character> = [];
    match target {
        Target.Spread(picks) => {
            for (p in picks) {
                var again = false;
                for (q in punched) {
                    if (same(p, q)) { again = true; }
                }
                if (again) {
                    out.push(follow_up_hit(user, p, flurry_power()));
                } else {
                    out.push(hit(user, p, flurry_power()));
                    punched.push(p);
                }
            }
        }
        _ => {}
    }
    return out;
}

/** One foe: a punch, and attack down and defense down. */
fn disarming_palm(): MoveDef {
    return MoveDef { name: "Disarming Palm", shape: TargetShape.SingleFoe, apply: disarming_palm_apply, cooldown: disarming_palm_cooldown(), basic: false };
}

/** One foe: a punch, and Heal Block for some of its turns. */
fn crippling_blow(): MoveDef {
    return MoveDef { name: "Crippling Blow", shape: TargetShape.SingleFoe, apply: crippling_blow_apply, cooldown: crippling_blow_cooldown(), basic: false };
}

/** Several picks, repeats allowed: a punch for each. */
fn flurry_of_blows(): MoveDef {
    return MoveDef { name: "Flurry of Blows", shape: TargetShape.FoePicks(flurry_picks()), apply: flurry_apply, cooldown: flurry_cooldown(), basic: false };
}

// Grim Reaper. See docs/characters.md.

fn reap_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(defender) => {
            var d = damage(user, defender, reap_power());
            // The max HP loss is a share of the damage that can land: a capped hit takes less (Ironclad).
            return [Action.Damage(defender, Option.Some(user), d, true), Action.Wound(defender, defender.capped(d) / reap_wound_divisor())];
        }
        _ => { return []; }
    }
    return [];
}

fn soul_siphon_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(defender) => { return [Action.Drain(defender, user, damage(user, defender, soul_siphon_power()), soul_siphon_drain_percent())]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: a hit; part of the damage also comes off its max HP. */
fn reap(): MoveDef {
    return MoveDef { name: "Reap", shape: TargetShape.SingleFoe, apply: reap_apply, cooldown: reap_cooldown(), basic: false };
}

/** One foe: a hit; the user heals a share of the HP the foe lost. */
fn soul_siphon(): MoveDef {
