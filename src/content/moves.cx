// Assassin. See docs/characters.md.

fn backstab_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(defender) => { return [hit(user, defender, backstab_power())]; }
        _ => { return []; }
    }
    return [];
}

/** What would stand between a hit and a knockout: HP plus any shield. */
fn toughness(c: Character): int {
    var total = c.hp;
    for (e in c.effects) {
        if (e.absorbs) { total = total + e.power; }
    }
    return total;
}

/**
 * Hits the lowest-HP foe; if that hit would knock it out, hits the next
 * lowest, and so on. Whether a hit knocks out is worked out here, from the
 * damage against HP plus shield, since the hits are decided before they land.
 */
fn execution_apply(battle: Battle, user: Character, target: Target): List<Action> {
    var out: List<Action> = [];
    match target {
        Target.Spread(foes) => {
            var left: List<Character> = [];
            for (f in foes) { left.push(f); }
            var going = true;
            while (going && left.len() > 0) {
                // The lowest HP; a tie goes to the earlier slot, which comes first in `foes`.
                var at = 0;
                var i = 1;
                while (i < left.len()) {
                    if (left[i].hp < left[at].hp) { at = i; }
                    i = i + 1;
                }
                var victim = left[at];
                var d = damage(user, victim, execution_power());
                out.push(Action.Damage(victim, Option.Some(user), d, true));
                going = d >= toughness(victim);
                var rest: List<Character> = [];
                var j = 0;
                while (j < left.len()) {
                    if (j != at) { rest.push(left[j]); }
                    j = j + 1;
                }
                left = rest;
            }
        }
        _ => {}
    }
    return out;
}

/** One foe: a heavy hit. */
fn backstab(): MoveDef {
    return MoveDef { name: "Backstab", shape: TargetShape.SingleFoe, apply: backstab_apply, cooldown: backstab_cooldown(), basic: false };
}

/** The weakest foe, moving on to the next weakest after each knockout. */
fn execution(): MoveDef {
    return MoveDef { name: "Execution", shape: TargetShape.Weakest, apply: execution_apply, cooldown: execution_cooldown(), basic: false };
}


fn spirit_link_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        // The foe's end first: if a Panacea blocks it, the link never holds.
        Target.Single(foe) => { return [Action.AddEffect(foe, spirit_link_debuff(user)), Action.AddEffect(user, spirit_link_buff(foe))]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: linked to the Shaman, which passes it part of its damage and takes part of its healing. */
fn spirit_link(): MoveDef {
    return MoveDef { name: "Spirit Link", shape: TargetShape.SingleFoe, apply: spirit_link_apply, cooldown: spirit_link_cooldown(), basic: false };
}

/** The Shaman's totem: a small minion that takes no turns. See docs/summons.md. */
fn new_totem(summoner: Character): Character {
    var t = character("Totem", 0, totem_defense(), Tier.Slow);
    t.base_max_hp = totem_hp();
    t.hp = totem_hp();
    t.effects.push(minion_marker(true));
    t.effects.push(totem_spirit(summoner));
    t.effects.push(totems_blessing());
    return t;
}

/** The totem carries its blessing as an aura, so it reaches the whole team, and whoever joins later, while it stands. */
fn totem_apply(battle: Battle, user: Character, target: Target): List<Action> {
    return [Action.Summon(user, new_totem(user))];
}

/**
 * Summons a totem: the whole team has more attack and defense while it stands.
 * One at a time; the cooldown starts when the totem is destroyed, so the move
 * itself has none.
 */
fn totem_move(): MoveDef {
    return MoveDef { name: "Totem", shape: TargetShape.Summon("Totem"), apply: totem_apply, cooldown: 0, basic: false };
}

// Bard. See docs/characters.md#bard.

fn allegro_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(ally) => { return [Action.AddEffect(ally, speed_up()), Action.AddEffect(ally, attack_up_next_turn())]; }
        _ => { return []; }
    }
    return [];
}

/** One ally, not the Bard: a tier faster and attack up, both for its next turn. */
fn allegro(): MoveDef {
    return MoveDef { name: "Allegro", shape: TargetShape.OtherAlly, apply: allegro_apply, cooldown: allegro_cooldown(), basic: false };
}

fn largo_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(foe) => { return [Action.AddEffect(foe, speed_down()), Action.AddEffect(foe, timed(attack_down(), largo_rounds()))]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: a tier slower for its next turn, and attack down. */
fn largo(): MoveDef {
    return MoveDef { name: "Largo", shape: TargetShape.SingleFoe, apply: largo_apply, cooldown: largo_cooldown(), basic: false };
}

// Fairy. See docs/characters.md#fairy.

fn fairy_ring_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        // Cleanse first, so a Heal Block is gone before the heal.
        Target.Single(ally) => { return [Action.Cleanse(ally), Action.Heal(ally, ally.max_health()), Action.AddEffect(ally, invincible())]; }
        _ => { return []; }
    }
    return [];
}

/** One ally, or the Fairy: cleansed, healed to full, and no damage for the rest of the round. */
fn fairy_ring(): MoveDef {
    return MoveDef { name: "Fairy Ring", shape: TargetShape.SingleAlly, apply: fairy_ring_apply, cooldown: fairy_ring_cooldown(), basic: false };
}

fn pixie_dust_apply(battle: Battle, user: Character, target: Target): List<Action> {
    var out: List<Action> = [];
    match target {
        Target.Spread(allies) => {
            for (a in allies) { out.push(Action.AddEffect(a, shield(pixie_dust_shield()))); }
        }
        _ => {}
    }
    return out;
}

/** All allies, the Fairy included: a shield on each. */
fn pixie_dust(): MoveDef {
    return MoveDef { name: "Pixie Dust", shape: TargetShape.AllAllies, apply: pixie_dust_apply, cooldown: pixie_dust_cooldown(), basic: false };
}

// Necromancer. See docs/characters.md#necromancer.

fn wither_apply(battle: Battle, user: Character, target: Target): List<Action> {
    var out: List<Action> = [];
    match target {
        Target.Spread(defenders) => {
            // Removing the corpse right after each hit takes only a foe this hit knocked out.
            for (d in defenders) {
                out.push(hit(user, d, wither_power()));
                out.push(Action.RemoveCorpse(d));
            }
        }
        _ => {}
    }
    return out;
}

/** All foes: a direct hit on each; a foe it knocks out leaves no corpse. */
fn wither(): MoveDef {
    return MoveDef { name: "Wither", shape: TargetShape.AllFoes, apply: wither_apply, cooldown: wither_cooldown(), basic: false };
}

/** The Necromancer's skeleton: a minion that takes turns, with only a basic attack. See docs/summons.md. */
fn new_skeleton(): Character {
    var s = character("Skeleton", skeleton_attack(), skeleton_defense(), Tier.Normal);
    s.base_max_hp = skeleton_hp();
    s.hp = skeleton_hp();
    s.effects.push(minion_marker(false));
    return s;
}

fn raise_dead_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(fallen) => { return [Action.RemoveCorpse(fallen), Action.Summon(user, new_skeleton())]; }
        _ => { return []; }
    }
    return [];
}

/** A fallen ally's corpse: removed, and a skeleton rises in its place. */
fn raise_dead(): MoveDef {
    return MoveDef { name: "Raise Dead", shape: TargetShape.AllyCorpse, apply: raise_dead_apply, cooldown: raise_dead_cooldown(), basic: false };
}

// Vampire. See docs/characters.md#vampire.

fn bite(): MoveDef { return single_hit("Bite", bite_power(), bite_cooldown()); }

fn hemorrhage_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(foe) => { return [hit(user, foe, hemorrhage_power()), Action.AddEffect(foe, bleed(user, hemorrhage_bleed(), hemorrhage_rounds()))]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: a light hit, and a bleed the Vampire deals. */
fn hemorrhage(): MoveDef {
    return MoveDef { name: "Hemorrhage", shape: TargetShape.SingleFoe, apply: hemorrhage_apply, cooldown: hemorrhage_cooldown(), basic: false };
}

// Cryomancer and Frost Giant. See docs/characters.md.

/** All foes: a direct hit and a chill on each. */
fn chilling_area(name: string, power: int, cooldown: int): MoveDef {
    fn strike(battle: Battle, user: Character, target: Target): List<Action> {
        var out: List<Action> = [];
        match target {
            Target.Spread(defenders) => {
                for (d in defenders) {
                    out.push(hit(user, d, power));
                    out.push(Action.AddEffect(d, chill()));
                }
            }
            _ => {}
        }
        return out;
    }
    return MoveDef { name: name, shape: TargetShape.AllFoes, apply: strike, cooldown: cooldown, basic: false };
}

fn blizzard(): MoveDef { return chilling_area("Blizzard", blizzard_power(), blizzard_cooldown()); }

fn frostbite_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(foe) => { return [hit(user, foe, frostbite_power()), Action.AddEffect(foe, chill())]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: a direct hit and a chill. */
fn frostbite(): MoveDef {
    return MoveDef { name: "Frostbite", shape: TargetShape.SingleFoe, apply: frostbite_apply, cooldown: frostbite_cooldown(), basic: false };
}

fn avalanche(): MoveDef { return chilling_area("Avalanche", avalanche_power(), avalanche_cooldown()); }

fn glacial_roar(): MoveDef { return taunt_move("Glacial Roar", glacial_roar_rounds(), glacial_roar_cooldown()); }

fn cryosleep_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(ally) => { return [Action.Heal(ally, cryosleep_heal()), Action.AddEffect(ally, cryosleep())]; }
        _ => { return []; }
    }
    return [];
}

/** One ally, not the Frost Giant: heals it, and it sleeps in the ice through its next turn, taking no damage. */
fn cryosleep_move(): MoveDef {
    return MoveDef { name: "Cryosleep", shape: TargetShape.OtherAlly, apply: cryosleep_apply, cooldown: cryosleep_cooldown(), basic: false };
}

// Construct. See docs/characters.md#construct.

fn piston_slam_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(defender) => { return [hit(user, defender, piston_slam_power()), Action.AddEffect(defender, timed(attack_down(), piston_slam_rounds()))]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: a hit, and attack down. Being Fast, it often lands before the foe acts. */
fn piston_slam(): MoveDef {
    return MoveDef { name: "Piston Slam", shape: TargetShape.SingleFoe, apply: piston_slam_apply, cooldown: piston_slam_cooldown(), basic: false };
}

fn lockdown(): MoveDef { return taunt_move("Lockdown", lockdown_rounds(), lockdown_cooldown()); }

fn overclock_apply(battle: Battle, user: Character, target: Target): List<Action> {
    var out: List<Action> = [];
    for (ally in battle.sides[user.team].active) {
        if (!ally.fainted()) { out.push(Action.ShortenCooldowns(ally, overclock_cut())); }
    }
    return out;
}

/** The whole team, the Construct too: every running cooldown shorter. Its own starts after. */
fn overclock(): MoveDef {
    return MoveDef { name: "Overclock", shape: TargetShape.User, apply: overclock_apply, cooldown: overclock_cooldown(), basic: false };
}

// Stormbringer. See docs/characters.md#stormbringer.

fn thunderstorm(): MoveDef { return area_hit("Thunderstorm", thunderstorm_power(), thunderstorm_cooldown()); }

fn chain_lightning_apply(battle: Battle, user: Character, target: Target): List<Action> {
    var out: List<Action> = [];
    var powers = chain_lightning_powers();
    match target {
        Target.Spread(foes) => {
            var i = 0;
            while (i < foes.len() && i < powers.len()) {
                out.push(hit(user, foes[i], powers[i]));
                i = i + 1;
            }
        }
        _ => {}
    }
    return out;
}

/** Different foes picked in order, a weaker bolt on each. */
fn chain_lightning(): MoveDef {
    return MoveDef { name: "Chain Lightning", shape: TargetShape.ChainPicks(chain_lightning_powers().len()), apply: chain_lightning_apply, cooldown: chain_lightning_cooldown(), basic: false };
}

// Ninja. See docs/characters.md#ninja.

fn shuriken(): MoveDef { return single_hit("Shuriken", shuriken_power(), shuriken_cooldown()); }

// Swashbuckler. See docs/characters.md#swashbuckler.

fn pistol_shot_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(foe) => { return [hit(user, foe, pistol_shot_power())]; }
        _ => { return []; }
    }
    return [];
}

/** Any foe, taunts and other targeting tiers aside: a direct hit. */
fn pistol_shot(): MoveDef {
    return MoveDef { name: "Pistol Shot", shape: TargetShape.AnyFoe, apply: pistol_shot_apply, cooldown: pistol_shot_cooldown(), basic: false };
}

fn en_garde_apply(battle: Battle, user: Character, target: Target): List<Action> { return [Action.AddEffect(user, parry())]; }

/** The user: Parry, until a foe's direct hit uses it up. */
fn en_garde(): MoveDef {
    return MoveDef { name: "En Garde", shape: TargetShape.User, apply: en_garde_apply, cooldown: en_garde_cooldown(), basic: false };
}

fn plunder_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        // Steal first, so a shield or barrier is the Swashbuckler's before the hit.
        Target.Single(foe) => { return [Action.Steal(foe, user), hit(user, foe, plunder_power())]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: steals every buff it can, then a direct hit. */
fn plunder(): MoveDef {
    return MoveDef { name: "Plunder", shape: TargetShape.SingleFoe, apply: plunder_apply, cooldown: plunder_cooldown(), basic: false };
}

// Jester. See docs/characters.md#jester.

fn trick_blade_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(defender) => { return [hit(user, defender, trick_blade_power()), Action.AddEffect(defender, silence(trick_blade_silence_turns()))]; }
        _ => { return []; }
    }
    return [];
}

/** One foe: a hit, and Silence for its next turn, so it has only its basic attack. Being Fast, it usually lands first. */
fn trick_blade(): MoveDef {
    return MoveDef { name: "Trick Blade", shape: TargetShape.SingleFoe, apply: trick_blade_apply, cooldown: trick_blade_cooldown(), basic: false };
}

/**
 * A fallen foe raised as a minion on the Jester's side: its stats, max HP lost,
 * cooldowns and passives, at a percent of its max HP. See docs/summons.md.
 */
fn new_puppet(fallen: Character, jester: Character): Character {
    var p = character("Puppet " + fallen.name, fallen.attack, fallen.defense, fallen.tier);
    p.base_max_hp = fallen.base_max_hp;
    p.lost_max_hp = fallen.lost_max_hp;
    p.hp = p.max_health() * puppet_percent() / 100;
    if (p.hp < 1) { p.hp = 1; }
    for (c in fallen.cooldowns) { p.cooldowns.push(c); }
    for (e in fallen.effects) {
        if (e.passive) { p.effects.push(copy_effect(e)); }
    }
    p.effects.push(minion_marker(false));
    p.effects.push(strings(jester));
    return p;
}

fn puppeteer_apply(battle: Battle, user: Character, target: Target): List<Action> {
    match target {
        Target.Single(fallen) => { return [Action.RemoveCorpse(fallen), Action.Summon(user, new_puppet(fallen, user))]; }
        _ => { return []; }
    }
    return [];
}

/**
 * A fallen foe's corpse: it rises as the Jester's puppet. One at a time; the
 * cooldown starts when the puppet falls, so the move itself has none.
 */
fn puppeteer(): MoveDef {
    return MoveDef { name: "Puppeteer", shape: TargetShape.PuppetCorpse, apply: puppeteer_apply, cooldown: 0, basic: false };
}
