import { Character, Effect, Event, EventKind, Action, trigger_id, in_chain, max_hp } from "../core/creature";
import { pow } from "../core/maths";
import { damage } from "../core/move";
import {
    rage_c, rage_a, rage_b, last_rites_percent, vigil_heal, potion_line_percent, energize_bonus_percent, energizer_bonus_percent, attune_bonus_percent, totem_heal, totem_cooldown,
    predator_bonus_percent, predator_line_percent, shield_decay, crescendo_attack_percent, crescendo_defense_percent, overture_percent, overture_fade_percent, marked_percent, frostbite_damage, sanguine_percent, chill_rounds, ironclad_cap_percent,
    puppeteer_cooldown, riposte_power, spirit_link_damage_percent, spirit_link_heal_percent, spirit_link_rounds, soul_harvest_heal, death_throes_power
} from "tuning";

fn never(owner: Character, fx: Effect, event: Event): bool { return false; }

fn nothing(owner: Character, fx: Effect, event: Event): List<Action> { return []; }

/** Reapplying leaves the effect as it is. */
fn keep(existing: Effect, incoming: Effect) {}

fn plain_label(owner: Character, fx: Effect): string { return fx.kind; }

fn unscaled(owner: Character, fx: Effect, attack: int): int { return attack; }

fn let_through(owner: Character, fx: Effect, action: Action): Option<List<Action>> { return Option.None; }

fn unscaled_hit(owner: Character, fx: Effect, target: Character, amount: int): int { return amount; }

/** An effect that does nothing on its own; the effect types below fill in what they need. */
fn base(kind: string, buff: bool): Effect {
    return Effect {
        kind: kind, buff: buff, immune: false, power: 0, rounds: 0, attack_steps: 0, defense_steps: 0, targeting: 0, unrestricted: false, charges: 0, skips: false, first_hit_only: false, absorbs: false, blocks_hits: false, silences: false, blocks_healing: false, minion: false, idle: false,
        tier_shift: 0, prevents_damage: false, hit_cap: 0, unstealable: false, passive: false, aura: false, takes_the_fall: false, stays_up: false, partner: [], redirect_damage: 0, redirect_healing: 0,
        should: never, react: nothing, merge: keep, scale_attack: unscaled, scale_defense: unscaled, scale_hit: unscaled_hit, label: plain_label,
        intercept: let_through
    };
}

/** The check every trigger starts from: it isn't already in the event's provenance. */
fn fresh(owner: Character, fx: Effect, event: Event): bool {
    return !in_chain(event, trigger_id(owner, fx));
}

fn at_round_end(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.RoundEnded => { return fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

// Timed effects count down at the end of each round and remove themselves at 0.
// Reapplying one resets the count to the longer of the two.

fn countdown_react(owner: Character, fx: Effect, event: Event): List<Action> {
    fx.rounds = fx.rounds - 1;
    if (fx.rounds <= 0) { return [Action.RemoveEffect(owner, fx.kind)]; }
    return [];
}

fn countdown_merge(existing: Effect, incoming: Effect) {
    if (incoming.rounds > existing.rounds) { existing.rounds = incoming.rounds; }
}

fn timed_label(owner: Character, fx: Effect): string { return fx.kind + " (" + str(fx.rounds) + ")"; }

/** The effect, lasting the given number of round ends. */
fn timed(fx: Effect, rounds: int): Effect {
    fx.rounds = rounds;
    fx.should = at_round_end;
    fx.react = countdown_react;
    fx.merge = countdown_merge;
    fx.label = timed_label;
    return fx;
}

/** Foes must target the owner (targeting tier +1). */
fn taunt(rounds: int): Effect {
    var e = base("Taunt", true);
    e.targeting = 1;
    return timed(e, rounds);
}

fn guard_label(owner: Character, fx: Effect): string { return "Taunt, DEF up (" + str(fx.rounds) + ")"; }

/** The Paladin's Guard: a taunt that also gives defense up (× 1.5) while it lasts. */
fn guarding_taunt(rounds: int): Effect {
    var e = taunt(rounds);
    e.defense_steps = 1;
    e.label = guard_label;
    return e;
}

// Stat ups and downs. They don't stack; an up and a down are separate types.

fn attack_up(): Effect {
    var e = base("Attack up", true);
    e.attack_steps = 1;
    return e;
}

fn attack_down(): Effect {
    var e = base("Attack down", false);
    e.attack_steps = -1;
    return e;
}

fn defense_up(): Effect {
    var e = base("Defense up", true);
    e.defense_steps = 1;
    return e;
}

fn defense_down(): Effect {
    var e = base("Defense down", false);
    e.defense_steps = -1;
    return e;
}

// Poison: at the end of every round, indirect damage equal to the amount, then the amount
// drops by 1; gone at 0. Stacks by adding to what's left (docs/effects.md#poison).

fn poison_react(owner: Character, fx: Effect, event: Event): List<Action> {
    var dealt = fx.power;
    fx.power = fx.power - 1;
    if (fx.power <= 0) { return [Action.Damage(owner, Option.None, dealt, false), Action.RemoveEffect(owner, fx.kind)]; }
    return [Action.Damage(owner, Option.None, dealt, false)];
}

fn poison_merge(existing: Effect, incoming: Effect) { existing.power = existing.power + incoming.power; }

fn poison_label(owner: Character, fx: Effect): string { return "Poison " + str(fx.power); }

fn poison(damage: int): Effect {
    var e = base("Poison", false);
    e.power = damage;
    e.should = at_round_end;
    e.react = poison_react;
    e.merge = poison_merge;
    e.label = poison_label;
    return e;
}

// Regen: heals at the end of the round for a number of rounds. Reapplying resets the count.

fn regen_react(owner: Character, fx: Effect, event: Event): List<Action> {
    fx.rounds = fx.rounds - 1;
    if (fx.rounds <= 0) {
        return [Action.Heal(owner, fx.power), Action.RemoveEffect(owner, fx.kind)];
    }
    return [Action.Heal(owner, fx.power)];
}

fn regen_merge(existing: Effect, incoming: Effect) {
    if (incoming.rounds > existing.rounds) { existing.rounds = incoming.rounds; }
}

fn regen_label(owner: Character, fx: Effect): string { return "Regen " + str(fx.power) + " (" + str(fx.rounds) + ")"; }

fn regen(amount: int, rounds: int): Effect {
    var e = base("Regen", true);
    e.power = amount;
    e.rounds = rounds;
    e.should = at_round_end;
    e.react = regen_react;
    e.merge = regen_merge;
    e.label = regen_label;
    return e;
}

// Retaliate: when hit directly, deals indirect damage back to the attacker.

fn retaliate_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.Damaged(target, source, _, direct, _) => {
            match source {
                Option.Some(_) => { return direct && same(target, owner) && fresh(owner, fx, event); }
                Option.None => { return false; }
            }
        }
        _ => { return false; }
    }
    return false;
}

fn retaliate_react(owner: Character, fx: Effect, event: Event): List<Action> {
    match event.kind {
        EventKind.Damaged(_, source, _, _, _) => {
            match source {
                Option.Some(attacker) => { return [Action.Damage(attacker, Option.Some(owner), fx.power, false)]; }
                Option.None => { return []; }
            }
        }
        _ => { return []; }
    }
    return [];
}

fn retaliate_label(owner: Character, fx: Effect): string { return "Retaliate " + str(fx.power); }

fn retaliate(damage: int): Effect {
    var e = base("Retaliate", true);
    e.power = damage;
    e.should = retaliate_should;
    e.react = retaliate_react;
    e.label = retaliate_label;
    return e;
}

// Grim Reaper, Spirit Link (the Shaman's until v0.0.9): a buff on the linker and a debuff on a foe,
// each naming the other. While both hold, part of the linker's damage goes to the foe and part of
// the foe's healing to the linker (the engine does the sharing). When either end goes (dispelled, cleansed, worn off), the other goes too.

/** It counts down its rounds like any timed effect, and ends when the partner's end goes. */
fn link_end_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.EffectRemoved(c, e) => { return fx.partner.len() > 0 && same(c, fx.partner[0]) && e.kind == fx.kind && fresh(owner, fx, event); }
        _ => { return at_round_end(owner, fx, event); }
    }
    return false;
}

fn link_end_react(owner: Character, fx: Effect, event: Event): List<Action> {
    match event.kind {
        EventKind.EffectRemoved(_, _) => { return [Action.RemoveEffect(owner, fx.kind)]; }
        _ => { return countdown_react(owner, fx, event); }
    }
    return [];
}

fn link_label(owner: Character, fx: Effect): string {
    var who = "";
    if (fx.partner.len() > 0) { who = " with " + fx.partner[0].name; }
    return fx.kind + who + " (" + str(fx.rounds) + ")";
}

fn spirit_link_end(buff: bool, partner: Character): Effect {
    var e = timed(base("Spirit Link", buff), spirit_link_rounds());
    e.partner = [partner];
    e.should = link_end_should;
    e.react = link_end_react;
    e.label = link_label;
    return e;
}

/** The linker's end: part of its damage goes to the foe. It can be dispelled, but not stolen. */
fn spirit_link_buff(foe: Character): Effect {
    var e = spirit_link_end(true, foe);
    e.unstealable = true;
    e.redirect_damage = spirit_link_damage_percent();
    return e;
}

/** The foe's end: part of its healing goes to the linker. It can be cleansed. */
fn spirit_link_debuff(linker: Character): Effect {
    var e = spirit_link_end(false, linker);
    e.redirect_healing = spirit_link_heal_percent();
    return e;
}

// Swashbuckler, Parry: blocks the next direct hit from a foe, however long that takes, and hits the
// attacker back (docs/characters.md#swashbuckler).

/** The foe that dealt a direct hit or drain, if the action is one. */
fn direct_attacker(owner: Character, action: Action): Option<Character> {
    match action {
        Action.Damage(_, source, _, direct) => {
            if (!direct) { return Option.None; }
            match source {
                Option.Some(attacker) => {
                    if (attacker.team != owner.team && !attacker.fainted()) { return Option.Some(attacker); }
                }
                Option.None => {}
            }
        }
        Action.Drain(_, attacker, _, _) => {
            if (attacker.team != owner.team && !attacker.fainted()) { return Option.Some(attacker); }
        }
        _ => {}
    }
    return Option.None;
}

fn riposte(owner: Character, attacker: Character): Action {
    return Action.Damage(attacker, Option.Some(owner), damage(owner, attacker, riposte_power()), true);
}

fn parry_intercept(owner: Character, fx: Effect, action: Action): Option<List<Action>> {
    match direct_attacker(owner, action) {
        Option.Some(attacker) => { return Option.Some([Action.RemoveEffect(owner, fx.kind), riposte(owner, attacker)]); }
        Option.None => {}
    }
    return Option.None;
}

/** Blocks the next direct hit from a foe and ripostes. It lasts until it's used. */
fn parry(): Effect {
    var e = base("Parry", true);
    e.intercept = parry_intercept;
    return e;
}

// Swashbuckler, On Guard: it starts every battle with a parry ready. The passive is that first
// parry: once it's used, it does nothing more (it's a passive, so it isn't removed).

fn on_guard_intercept(owner: Character, fx: Effect, action: Action): Option<List<Action>> {
    if (fx.charges <= 0) { return Option.None; }
    match direct_attacker(owner, action) {
        Option.Some(attacker) => {
            fx.charges = 0;
            return Option.Some([riposte(owner, attacker)]);
        }
        Option.None => {}
    }
    return Option.None;
}

fn on_guard_label(owner: Character, fx: Effect): string {
    if (fx.charges > 0) { return "On Guard (parry ready)"; }
    return "On Guard";
}

fn on_guard(): Effect {
    var e = base("On Guard", true);
    e.immune = true;
    e.charges = 1;
    e.intercept = on_guard_intercept;
    e.label = on_guard_label;
    return e;
}

// Passives: buffs every character of a kind starts with. They can't be removed.

// Barbarian, Rage: attack × (c + a(1 − hp/max)^b), c, a and b in tuning.cx. See docs/characters.md.

/** The attack multiplier at the owner's current HP. */
fn rage_multiplier(owner: Character): float {
    var missing = 1.0 - owner.hp.to_float() / owner.base_max_hp.to_float();
    return rage_c() + rage_a() * pow(missing, rage_b());
}

fn rage_scale(owner: Character, fx: Effect, attack: int): int {
    return (attack.to_float() * rage_multiplier(owner)).to_int();
}

fn rage_label(owner: Character, fx: Effect): string {
    var hundredths = (rage_multiplier(owner) * 100.0).to_int();
    var cents = str(hundredths % 100);
    if (hundredths % 100 < 10) { cents = "0" + cents; }
    return "Rage ×" + str(hundredths / 100) + "." + cents;
}

fn rage(): Effect {
    var e = base("Rage", true);
    e.immune = true;
    e.scale_attack = rage_scale;
    e.label = rage_label;
    return e;
}

// Paladin, Last Rites: when the Paladin falls, the first fallen ally in slot order
// is resurrected.

fn last_rites_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.Fainted(c) => { return same(c, owner) && fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

fn last_rites_react(owner: Character, fx: Effect, event: Event): List<Action> {
    return [Action.ResurrectFirstFallen(owner, fx.power)];
}

fn last_rites(): Effect {
    var e = base("Last Rites", true);
    e.immune = true;
    e.power = last_rites_percent();
    e.should = last_rites_should;
    e.react = last_rites_react;
    return e;
}

// Ranger, Keen Eye: ignores targeting restrictions.

fn keen_eye(): Effect {
    var e = base("Keen Eye", true);
    e.immune = true;
    e.unrestricted = true;
    return e;
}

// Cleric, Vigil: at the end of each round, heals the lowest-HP ally.

fn vigil_react(owner: Character, fx: Effect, event: Event): List<Action> {
    return [Action.HealLowestAlly(owner, fx.power)];
}

fn vigil(): Effect {
    var e = base("Vigil", true);
    e.immune = true;
    e.power = vigil_heal();
    e.should = at_round_end;
    e.react = vigil_react;
    return e;
}

// Lost turns. A `skips` effect makes the owner lose its next turn, then goes away. Each lost
// turn uses up one of them, the first on the owner, so a character with a Hex and a Freeze
// loses two turns.

fn first_skip(owner: Character, fx: Effect): bool {
    for (e in owner.effects) {
        if (e.skips) { return same(e, fx); }
    }
    return false;
}

fn skip_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.TurnStarted(c) => { return same(c, owner) && first_skip(owner, fx) && fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

fn skip_react(owner: Character, fx: Effect, event: Event): List<Action> {
    return [Action.RemoveEffect(owner, fx.kind)];
}

/** The effect, making the owner lose its next turn. */
fn skipping(fx: Effect): Effect {
    fx.skips = true;
    fx.should = skip_should;
    fx.react = skip_react;
    return fx;
}

// Witch, Hex: the owner loses its next turn, then the Hex goes away.

fn hex_label(owner: Character, fx: Effect): string { return "Hex (frog)"; }

fn hex(): Effect {
    var e = skipping(base("Hex", false));
    e.label = hex_label;
    return e;
}

// Alchemist potions. Each is a buff with charges: tossing another adds a
// charge, and each use spends one. See docs/characters.md.

fn add_charges(existing: Effect, incoming: Effect) { existing.charges = existing.charges + incoming.charges; }

fn potion_label(owner: Character, fx: Effect): string {
    if (fx.charges > 1) { return fx.kind + " ×" + str(fx.charges); }
    return fx.kind;
}

/** Spends one charge; the actions to run, removing the potion when it is empty. */
fn spend(owner: Character, fx: Effect, actions: List<Action>): List<Action> {
    fx.charges = fx.charges - 1;
    if (fx.charges <= 0) { actions.push(Action.RemoveEffect(owner, fx.kind)); }
    return actions;
}

fn potion(kind: string): Effect {
    var e = base(kind, true);
    e.charges = 1;
    e.merge = add_charges;
    e.label = potion_label;
    return e;
}

// Greater Health Potion: heals when the owner is below the potion line (a percent of its max HP),
// after damage or as soon as it's tossed.

/** Below the potion line: under `potion_line_percent` of the current max HP. */
fn below_potion_line(c: Character): bool { return c.hp * 100 < c.max_health() * potion_line_percent(); }

fn health_potion_should(owner: Character, fx: Effect, event: Event): bool {
    if (!below_potion_line(owner) || !fresh(owner, fx, event)) { return false; }
    match event.kind {
        EventKind.Damaged(target, _, _, _, _) => { return same(target, owner); }
        EventKind.EffectAdded(target, added) => { return same(target, owner) && same(added, fx); }
        _ => { return false; }
    }
    return false;
}

fn health_potion_react(owner: Character, fx: Effect, event: Event): List<Action> {
    return spend(owner, fx, [Action.Heal(owner, fx.power)]);
}

fn greater_health_potion(amount: int): Effect {
    var e = potion("Greater Health Potion");
    e.power = amount;
    e.should = health_potion_should;
    e.react = health_potion_react;
    return e;
}

// Panacea: blocks the next debuff put on the owner.

fn panacea_intercept(owner: Character, fx: Effect, action: Action): Option<List<Action>> {
    match action {
        Action.AddEffect(_, incoming) => {
            if (incoming.buff) { return Option.None; }
            return Option.Some(spend(owner, fx, []));
        }
        _ => { return Option.None; }
    }
    return Option.None;
}

fn panacea(): Effect {
    var e = potion("Panacea");
    e.intercept = panacea_intercept;
    return e;
}

// Chaos (the Jester's Pandemonium, v0.0.9): the reverse of a Panacea. A debuff whose stacks each
// eat the next buff that would be put on the owner (docs/effects.md#chaos).

fn chaos_intercept(owner: Character, fx: Effect, action: Action): Option<List<Action>> {
    match action {
        Action.AddEffect(_, incoming) => {
            if (!incoming.buff) { return Option.None; }
            return Option.Some(spend(owner, fx, []));
        }
        _ => { return Option.None; }
    }
    return Option.None;
}

/** One stack of Chaos; another adds a stack. */
fn chaos(): Effect {
    var e = base("Chaos", false);
    e.charges = 1;
    e.merge = add_charges;
    e.label = potion_label;
    e.intercept = chaos_intercept;
    return e;
}

// Last Breath (the Alchemist's, v0.0.9): until the end of the round, damage that would knock the
// owner out leaves it at 1 HP instead, and the potion is used up (the engine does it, through
// `stays_up`). The owner never falls, so nothing that waits for a fall happens.

fn last_breath(): Effect {
    var e = base("Last Breath", true);
    e.stays_up = true;
    return timed(e, 1);
}

// Barrier: blocks the next direct hit on the owner completely, then one charge is spent
// (docs/effects.md). The engine checks for it before shields, when the damage lands.

fn barrier(): Effect {
    var e = potion("Barrier");
    e.blocks_hits = true;
    return e;
}

// Energize: the owner's next damaging move gets more attack, then one charge is spent. The
// boost covers every hit the move computes.

fn energize_scale(owner: Character, fx: Effect, attack: int): int { return attack * (100 + energize_bonus_percent()) / 100; }

fn energize_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.MoveUsed(user, damaging) => { return damaging && same(user, owner) && fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

fn energize_react(owner: Character, fx: Effect, event: Event): List<Action> { return spend(owner, fx, []); }

fn energize(): Effect {
    var e = potion("Energize");
    e.scale_attack = energize_scale;
    e.first_hit_only = true;
    e.should = energize_should;
    e.react = energize_react;
    return e;
}

// Stacking buffs: the Alchemist's Energized and the Shaman's Attuned. Each stays for the rest of
// the battle and can't be removed. Its `power` is its stacks, and each multiplies attack and
// defense by 100 + its percent, over 100 (docs/characters.md#alchemist, #shaman).

/** The stat with `stacks` stacks of a buff that adds `percent` each, multiplying. */
fn stacked_stat(stat: int, stacks: int, percent: int): int {
    var out = stat;
    var i = 0;
    while (i < stacks) {
        out = out * (100 + percent) / 100;
        i = i + 1;
    }
    return out;
}

/** The stat with the given number of stacks of Energized on it. */
fn energized_stat(stat: int, stacks: int): int { return stacked_stat(stat, stacks, energizer_bonus_percent()); }

/** The stat with the given number of stacks of Attuned on it. */
fn attuned_stat(stat: int, stacks: int): int { return stacked_stat(stat, stacks, attune_bonus_percent()); }

fn energized_scale(owner: Character, fx: Effect, stat: int): int { return energized_stat(stat, fx.power); }
fn attuned_scale(owner: Character, fx: Effect, stat: int): int { return attuned_stat(stat, fx.power); }

fn add_stacks(existing: Effect, incoming: Effect) { existing.power = existing.power + incoming.power; }

/** "Name ×1.32": what the stacks multiply by, to two places. */
fn stacked_label(name: string, hundredths: int): string {
    var cents = str(hundredths % 100);
    if (hundredths % 100 < 10) { cents = "0" + cents; }
    return name + " ×" + str(hundredths / 100) + "." + cents;
}

fn energized_label(owner: Character, fx: Effect): string { return stacked_label("Energized", energized_stat(100, fx.power)); }
fn attuned_label(owner: Character, fx: Effect): string { return stacked_label("Attuned", attuned_stat(100, fx.power)); }

/** A stacking buff: one stack, immune to removal; another adds a stack. */
fn stacking(name: string): Effect {
    var e = base(name, true);
    e.immune = true;
    e.power = 1;
    e.merge = add_stacks;
    return e;
}

/** One stack of Energized; another adds a stack. */
fn energized(): Effect {
    var e = stacking("Energized");
    e.scale_attack = energized_scale;
    e.scale_defense = energized_scale;
    e.label = energized_label;
    return e;
}

/** One stack of Attuned (the Shaman's Attune); another adds a stack. */
fn attuned(): Effect {
    var e = stacking("Attuned");
    e.scale_attack = attuned_scale;
    e.scale_defense = attuned_scale;
    e.label = attuned_label;
    return e;
}

// Alchemist, Panacea Supply: at the start of the battle (the first round), every standing teammate
// gets a Panacea. Only once; Panacea Mist hands out more.

fn at_round_start(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.RoundStarted => { return fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

/** Its `power` is 1 once it has handed out the Panaceas. */
fn panacea_supply_should(owner: Character, fx: Effect, event: Event): bool { return fx.power == 0 && !owner.fainted() && at_round_start(owner, fx, event); }

fn panacea_supply_react(owner: Character, fx: Effect, event: Event): List<Action> {
    fx.power = 1;
    return [Action.AddToTeam(owner, panacea)];
}

fn panacea_supply(): Effect {
    var e = base("Panacea Supply", true);
    e.immune = true;
    e.should = panacea_supply_should;
    e.react = panacea_supply_react;
    return e;
}

// Monk, Inner Peace: purges its oldest debuff at the end of each of its turns.

fn inner_peace_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.TurnEnded(c) => { return same(c, owner) && fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

fn inner_peace_react(owner: Character, fx: Effect, event: Event): List<Action> {
    for (e in owner.effects) {
        if (!e.buff && !e.immune) { return [Action.RemoveEffect(owner, e.kind)]; }
    }
    return [];
}

fn inner_peace(): Effect {
    var e = base("Inner Peace", true);
    e.immune = true;
    e.should = inner_peace_should;
    e.react = inner_peace_react;
    return e;
}

// Grim Reaper, Soul Harvest: any foe that falls, however it falls, loses its corpse, and the
// Grim Reaper heals for it. A minion leaves no corpse, so it gives nothing, and a fallen Reaper
// harvests nothing.

fn soul_harvest_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.Fainted(c) => {
            return c.team != owner.team && c.team >= 0 && !c.is_minion() && c.corpse && !owner.fainted() && fresh(owner, fx, event);
        }
        _ => { return false; }
    }
    return false;
}

fn soul_harvest_react(owner: Character, fx: Effect, event: Event): List<Action> {
    match event.kind {
        EventKind.Fainted(c) => { return [Action.RemoveCorpse(c), Action.Heal(owner, soul_harvest_heal())]; }
        _ => { return []; }
    }
    return [];
}

fn soul_harvest(): Effect {
    var e = base("Soul Harvest", true);
    e.immune = true;
    e.should = soul_harvest_should;
    e.react = soul_harvest_react;
    return e;
}

// Shield: temporary HP that damage takes first. Stacks by adding and loses `shield_decay`
// at the end of every round. See docs/effects.md#shield.

fn shield_react(owner: Character, fx: Effect, event: Event): List<Action> {
    fx.power = fx.power - shield_decay();
    if (fx.power <= 0) { return [Action.RemoveEffect(owner, fx.kind)]; }
    return [];
}

fn shield_merge(existing: Effect, incoming: Effect) { existing.power = existing.power + incoming.power; }

fn shield_label(owner: Character, fx: Effect): string { return "Shield " + str(fx.power); }

fn shield(amount: int): Effect {
    var e = base("Shield", true);
    e.power = amount;
    e.absorbs = true;
    e.should = at_round_end;
    e.react = shield_react;
    e.merge = shield_merge;
    e.label = shield_label;
    return e;
}

// Effects that last a number of the owner's own turns, kept in `power`, and
// count down when each of its turns ends.

fn own_turn_ended(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.TurnEnded(c) => { return same(c, owner) && fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

fn own_turns_react(owner: Character, fx: Effect, event: Event): List<Action> {
    fx.power = fx.power - 1;
    if (fx.power <= 0) { return [Action.RemoveEffect(owner, fx.kind)]; }
    return [];
}

fn for_own_turns(fx: Effect, turns: int): Effect {
    fx.power = turns;
    fx.should = own_turn_ended;
    fx.react = own_turns_react;
    return fx;
}

/** Only the basic attack, for a number of the owner's turns (usually 1, its next turn). */
fn silence(turns: int): Effect {
    var e = base("Silence", false);
    e.silences = true;
    return for_own_turns(e, turns);
}

fn heal_block_label(owner: Character, fx: Effect): string { return "Heal Block (" + str(fx.power) + ")"; }

/** No healing of any kind, for a number of the owner's turns. */
fn heal_block(turns: int): Effect {
    var e = base("Heal Block", false);
    e.blocks_healing = true;
    e.label = heal_block_label;
    return for_own_turns(e, turns);
}

// Assassin, Predator: more damage against a target below a line (a percent of its max HP). See
// docs/characters.md.

/** The damage multiplier against a target at its current HP: boosted below the line, 1 otherwise. */
fn predator_multiplier(target: Character): float {
    if (target.hp * 100 < target.max_health() * predator_line_percent()) { return 1.0 + predator_bonus_percent().to_float() / 100.0; }
    return 1.0;
}

fn predator_hit(owner: Character, fx: Effect, target: Character, amount: int): int {
    return (amount.to_float() * predator_multiplier(target)).to_int();
}

fn predator(): Effect {
    var e = base("Predator", true);
    e.immune = true;
    e.scale_hit = predator_hit;
    return e;
}

// Summons (docs/summons.md)

fn minion_label(owner: Character, fx: Effect): string {
    if (fx.idle) { return "Minion (no turns)"; }
    return "Minion";
}

/** Marks a summon: not counted for winning or losing, no corpse; `idle` ones never take turns. */
fn minion_marker(idle: bool): Effect {
    var e = base("Minion", true);
    e.immune = true;
    e.minion = true;
    e.idle = idle;
    e.label = minion_label;
    return e;
}

fn standing_label(owner: Character, fx: Effect): string { return fx.kind; }

/**
 * The totem's taunt: foes must target it while it stands (targeting tier +1).
 * Part of the totem, so it never wears off and can't be removed; it ends when
 * the totem falls. (Until v0.0.9 the totem had an aura instead.)
 */
fn totem_taunt(): Effect {
    var e = base("Taunt", true);
    e.immune = true;
    e.targeting = 1;
    e.label = standing_label;
    return e;
}

fn totem_heal_react(owner: Character, fx: Effect, event: Event): List<Action> { return [Action.HealTeam(owner, fx.power)]; }

/** The totem's heal: every ally standing, the totem included, heals a little at the end of each round. */
fn totem_mending(): Effect {
    var e = base("Mending", true);
    e.immune = true;
    e.power = totem_heal();
    e.should = at_round_end;
    e.react = totem_heal_react;
    e.label = standing_label;
    return e;
}

fn totem_spirit_should(owner: Character, fx: Effect, event: Event): bool {
    if (!fresh(owner, fx, event)) { return false; }
    match event.kind {
        EventKind.Fainted(c) => { return same(c, owner) && fx.partner.len() > 0; }
        _ => { return false; }
    }
    return false;
}

fn totem_spirit_react(owner: Character, fx: Effect, event: Event): List<Action> { return [Action.StartCooldown(fx.partner[0], "Totem", totem_cooldown())]; }

/**
 * The totem's own effect: when the totem falls, the summoner's Totem move
 * starts its cooldown. The summoner is kept as its `partner`.
 */
fn totem_spirit(summoner: Character): Effect {
    var e = base("Totem", true);
    e.immune = true;
    e.partner = [summoner];
    e.should = totem_spirit_should;
    e.react = totem_spirit_react;
    return e;
}

/** A copy of the effect, with its own state. */
fn copy_effect(e: Effect): Effect {
    return Effect {
        kind: e.kind, buff: e.buff, immune: e.immune, power: e.power, rounds: e.rounds, attack_steps: e.attack_steps, defense_steps: e.defense_steps, targeting: e.targeting, unrestricted: e.unrestricted, charges: e.charges, skips: e.skips, first_hit_only: e.first_hit_only, absorbs: e.absorbs, blocks_hits: e.blocks_hits, silences: e.silences, blocks_healing: e.blocks_healing, minion: e.minion, idle: e.idle,
        tier_shift: e.tier_shift, prevents_damage: e.prevents_damage, hit_cap: e.hit_cap, unstealable: e.unstealable, passive: e.passive, aura: e.aura, takes_the_fall: e.takes_the_fall, stays_up: e.stays_up, partner: e.partner, redirect_damage: e.redirect_damage, redirect_healing: e.redirect_healing,
        should: e.should, react: e.react, merge: e.merge, scale_attack: e.scale_attack, scale_defense: e.scale_defense, scale_hit: e.scale_hit, label: e.label,
        intercept: e.intercept
    };
}

// Speed up and speed down: one tier faster or slower for the owner's next turn
// (docs/effects.md#speed-up-and-speed-down). Reapplying leaves it as it is.

fn next_turn_label(owner: Character, fx: Effect): string { return fx.kind + " (next turn)"; }

fn speed_up(): Effect {
    var e = base("Speed up", true);
    e.tier_shift = 1;
    e = for_own_turns(e, 1);
    e.label = next_turn_label;
    return e;
}

fn speed_down(): Effect {
    var e = base("Speed down", false);
    e.tier_shift = -1;
    e = for_own_turns(e, 1);
    e.label = next_turn_label;
    return e;
}

/** Attack up for the owner's next turn only (the Bard's Allegro until v0.0.9). */
fn attack_up_next_turn(): Effect {
    var e = for_own_turns(attack_up(), 1);
    e.label = next_turn_label;
    return e;
}

// Bard, Overture: a team aura that opens the battle with more attack and fades at each round end
// it sees, to nothing by round 4. Its `power` is the percent it adds now (docs/characters.md#bard).

fn overture_attack(owner: Character, fx: Effect, attack: int): int { return attack * (100 + fx.power) / 100; }

fn overture_react(owner: Character, fx: Effect, event: Event): List<Action> {
    fx.power = fx.power - overture_fade_percent();
    if (fx.power < 0) { fx.power = 0; }
    return [];
}

fn overture_label(owner: Character, fx: Effect): string {
    if (fx.power <= 0) { return "Overture (over)"; }
    return "Overture atk " + times(100 + fx.power) + " (aura)";
}

/** The Bard's passive: the team's attack up by `overture_percent` in round 1, less each round after. */
fn overture(): Effect {
    var e = base("Overture", true);
    e.immune = true;
    e.aura = true;
    e.power = overture_percent();
    e.scale_attack = overture_attack;
    e.should = at_round_end;
    e.react = overture_react;
    e.label = overture_label;
    return e;
}

fn marked_defense(owner: Character, fx: Effect, defense: int): int { return defense * 100 / (100 + marked_percent()); }

/** Hunter's Mark's debuff: hits on the owner deal `marked_percent` more, for the rounds given. Its own kind, so it multiplies with defense down. */
fn marked(rounds: int): Effect {
    var e = base("Marked", false);
    e.scale_defense = marked_defense;
    return timed(e, rounds);
}

fn cold(c: Character): bool {
    if (c.fainted()) { return false; }
    match c.find_effect("Chill") {
        Option.Some(_) => { return true; }
        Option.None => {}
    }
    match c.find_effect("Freeze") {
        Option.Some(_) => { return true; }
        Option.None => {}
    }
    return false;
}

fn frostbite_react(owner: Character, fx: Effect, event: Event): List<Action> {
    var out: List<Action> = [];
    for (foe in owner.foes) {
        if (cold(foe)) { out.push(Action.Damage(foe, Option.Some(owner), fx.power, false)); }
    }
    return out;
}

/**
 * The Cryomancer's passive (v0.0.9): at the end of every round, each chilled
 * or frozen foe takes a little indirect damage from it.
 */
fn frostbite(): Effect {
    var e = base("Frostbite", true);
    e.immune = true;
    e.power = frostbite_damage();
    e.should = at_round_end;
    e.react = frostbite_react;
    return e;
}

/** Heckle's taunt, on a foe: a debuff, so the Bard's team must pick the foe (targeting tier +1). */
fn heckled(rounds: int): Effect {
    var e = base("Heckled", false);
    e.targeting = 1;
    return timed(e, rounds);
}

fn curtains_defense(owner: Character, fx: Effect, defense: int): int { return defense / 2; }

/** Curtains: defense halved, so hits deal double, until the end of the round. */
fn curtains(): Effect {
    var e = base("Curtains", false);
    e.scale_defense = curtains_defense;
    return timed(e, 1);
}

// Bard, Crescendo (its passive until v0.0.9): a team aura that builds a stack for every foe
// character that falls, each adding a percent to attack and defense.

fn crescendo_attack(owner: Character, fx: Effect, attack: int): int { return attack * (100 + crescendo_attack_percent() * fx.power) / 100; }
fn crescendo_defense(owner: Character, fx: Effect, defense: int): int { return defense * (100 + crescendo_defense_percent() * fx.power) / 100; }

/** A percent as a multiplier: 117 gives "×1.17". */
fn times(percent: int): string {
    var cents = str(percent % 100);
    if (percent % 100 < 10) { cents = "0" + cents; }
    return "×" + str(percent / 100) + "." + cents;
}

fn crescendo_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.Fainted(c) => { return c.team != owner.team && c.team >= 0 && !c.is_minion() && !owner.fainted() && fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

fn crescendo_react(owner: Character, fx: Effect, event: Event): List<Action> {
    fx.power = fx.power + 1;
    return [];
}

fn crescendo_label(owner: Character, fx: Effect): string {
    var attack = times(100 + crescendo_attack_percent() * fx.power);
    var defense = times(100 + crescendo_defense_percent() * fx.power);
    return "Crescendo atk " + attack + ", def " + defense + " (aura)";
}

/** The Bard's passive: no stacks to start, one for each foe character that falls while it stands. */
fn crescendo(): Effect {
    var e = base("Crescendo", true);
    e.immune = true;
    e.aura = true;
    e.scale_attack = crescendo_attack;
    e.scale_defense = crescendo_defense;
    e.should = crescendo_should;
    e.react = crescendo_react;
    e.label = crescendo_label;
    return e;
}

// Fairy, Fairy Ring: Invincible until the round is over. It goes at the start of the next round,
// so the end of the round's damage (poison, fatigue) is covered too.

fn round_start_react(owner: Character, fx: Effect, event: Event): List<Action> { return [Action.RemoveEffect(owner, fx.kind)]; }

fn invincible(): Effect {
    var e = base("Invincible", true);
    e.prevents_damage = true;
    e.should = at_round_start;
    e.react = round_start_react;
    return e;
}

// Fairy, Fae Bargain: the first ally a hit would knock out stands instead, with the Fairy's HP,
// and the Fairy falls. The engine does the swap (`fall_instead` in engine.cx).

fn fae_bargain(): Effect {
    var e = base("Fae Bargain", true);
    e.immune = true;
    e.takes_the_fall = true;
    return e;
}

// Vampire, Bleed: indirect damage at the end of each round for a number of rounds, dealt by
// whoever caused it. Reapplying resets it rather than adding (docs/effects.md#bleed).

fn bleed_merge(existing: Effect, incoming: Effect) {
    existing.rounds = incoming.rounds;
    if (incoming.power > existing.power) { existing.power = incoming.power; }
}

fn bleed_label(owner: Character, fx: Effect): string { return "Bleed " + str(fx.power) + " (" + str(fx.rounds) + ")"; }

/** Whoever caused the bleed, kept as its `partner` so a copy of the battle points at the copy's character. */
fn bleed_react(owner: Character, fx: Effect, event: Event): List<Action> {
    fx.rounds = fx.rounds - 1;
    var source: Option<Character> = Option.None;
    if (fx.partner.len() > 0) { source = Option.Some(fx.partner[0]); }
    var out: List<Action> = [Action.Damage(owner, source, fx.power, false)];
    if (fx.rounds <= 0) { out.push(Action.RemoveEffect(owner, fx.kind)); }
    return out;
}

fn bleed(source: Character, amount: int, rounds: int): Effect {
    var e = base("Bleed", false);
    e.partner = [source];
    e.power = amount;
    e.rounds = rounds;
    e.should = at_round_end;
    e.react = bleed_react;
    e.merge = bleed_merge;
    e.label = bleed_label;
    return e;
}

// Vampire, Sanguine: heals a percent of the HP its damage takes off a foe.

fn sanguine_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.Damaged(_, source, _, _, lost) => {
            match source {
                Option.Some(s) => { return same(s, owner) && lost * sanguine_percent() / 100 > 0 && fresh(owner, fx, event); }
                Option.None => { return false; }
            }
        }
        _ => { return false; }
    }
    return false;
}

fn sanguine_react(owner: Character, fx: Effect, event: Event): List<Action> {
    match event.kind {
        EventKind.Damaged(_, _, _, _, lost) => { return [Action.Heal(owner, lost * sanguine_percent() / 100)]; }
        _ => { return []; }
    }
    return [];
}

fn sanguine(): Effect {
    var e = base("Sanguine", true);
    e.immune = true;
    e.should = sanguine_should;
    e.react = sanguine_react;
    return e;
}

// Chill and freeze (docs/effects.md#chill-and-freeze). Chilling a chilled character freezes it:
// the second chill merges into the first, which then turns itself into a Freeze. A frozen
// character can't be chilled.

fn freeze_intercept(owner: Character, fx: Effect, action: Action): Option<List<Action>> {
    match action {
        Action.AddEffect(_, incoming) => {
            if (incoming.kind == "Chill") { return Option.Some([]); }
            return Option.None;
        }
        _ => { return Option.None; }
    }
    return Option.None;
}

fn freeze(): Effect {
    var e = skipping(base("Freeze", false));
    e.intercept = freeze_intercept;
    return e;
}

fn chill_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.RoundEnded => { return fresh(owner, fx, event); }
        EventKind.EffectAdded(target, added) => { return same(target, owner) && same(added, fx) && fx.power >= 2 && fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

fn chill_react(owner: Character, fx: Effect, event: Event): List<Action> {
    match event.kind {
        EventKind.RoundEnded => { return countdown_react(owner, fx, event); }
        _ => { return [Action.RemoveEffect(owner, fx.kind), Action.AddEffect(owner, freeze())]; }
    }
    return [];
}

/** A second chill: counted, so the chill can turn into a freeze. */
fn chill_merge(existing: Effect, incoming: Effect) { existing.power = existing.power + incoming.power; }

fn chill(): Effect {
    var e = base("Chill", false);
    e.power = 1;
    e.rounds = chill_rounds();
    e.should = chill_should;
    e.react = chill_react;
    e.merge = chill_merge;
    e.label = timed_label;
    return e;
}

// Frost Giant, Cold Aura: a foe that hits it directly is chilled.

fn cold_aura_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.Damaged(target, source, _, direct, _) => {
            match source {
                Option.Some(s) => { return direct && same(target, owner) && s.team != owner.team && !s.fainted() && fresh(owner, fx, event); }
                Option.None => { return false; }
            }
        }
        _ => { return false; }
    }
    return false;
}

fn cold_aura_react(owner: Character, fx: Effect, event: Event): List<Action> {
    match event.kind {
        EventKind.Damaged(_, source, _, _, _) => {
            match source {
                Option.Some(s) => { return [Action.AddEffect(s, chill())]; }
                Option.None => { return []; }
            }
        }
        _ => { return []; }
    }
    return [];
}

fn cold_aura(): Effect {
    var e = base("Cold Aura", true);
    e.immune = true;
    e.should = cold_aura_should;
    e.react = cold_aura_react;
    return e;
}

// Frost Giant, Cryosleep: the owner loses its next turn and takes no damage until then. A buff
// that can be dispelled but not stolen (docs/effects.md#cryosleep).

fn cryosleep(): Effect {
    var e = skipping(base("Cryosleep", true));
    e.prevents_damage = true;
    e.unstealable = true;
    return e;
}

// Construct, Ironclad: it can't be healed, and no one instance of damage takes more than a
// percent of its max HP.

fn ironclad(): Effect {
    var e = base("Ironclad", true);
    e.immune = true;
    e.blocks_healing = true;
    e.hit_cap = ironclad_cap_percent();
    return e;
}

// Necromancer, Death Throes: when it falls, a direct hit on every foe standing, from the
// Necromancer, with its attack as it stood. A fallen character's effects hear their own fall.

fn death_throes_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.Fainted(c) => { return same(c, owner) && fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

fn death_throes_react(owner: Character, fx: Effect, event: Event): List<Action> {
    var out: List<Action> = [];
    for (foe in owner.foes) {
        if (!foe.fainted()) { out.push(Action.Damage(foe, Option.Some(owner), damage(owner, foe, death_throes_power()), true)); }
    }
    return out;
}

fn death_throes(): Effect {
    var e = base("Death Throes", true);
    e.immune = true;
    e.should = death_throes_should;
    e.react = death_throes_react;
    return e;
}

// Ninja, Shroud: targeting tier -1 (docs/targeting.md#shroud) until the start of its holder's
// next turn. A buff: a dispel removes it and a steal takes it, from a foe that can pick the Ninja.
// Shadowed, the Ninja's passive, shrouds it at the start of the battle; Shadow Strike shrouds it
// again.

fn shroud_should(owner: Character, fx: Effect, event: Event): bool {
    match event.kind {
        EventKind.TurnStarted(c) => { return same(c, owner) && fresh(owner, fx, event); }
        _ => { return false; }
    }
    return false;
}

fn shroud_react(owner: Character, fx: Effect, event: Event): List<Action> { return [Action.RemoveEffect(owner, fx.kind)]; }

fn shroud(): Effect {
    var e = base("Shroud", true);
    e.targeting = -1;
    e.should = shroud_should;
    e.react = shroud_react;
    return e;
}

/** Its `power` is 1 once it has shrouded the Ninja. */
fn shadowed_should(owner: Character, fx: Effect, event: Event): bool { return fx.power == 0 && !owner.fainted() && at_round_start(owner, fx, event); }

fn shadowed_react(owner: Character, fx: Effect, event: Event): List<Action> {
    fx.power = 1;
    return [Action.AddEffect(owner, shroud())];
}

fn shadowed(): Effect {
    var e = base("Shadowed", true);
    e.immune = true;
    e.should = shadowed_should;
    e.react = shadowed_react;
    return e;
}

// Jester's puppets (docs/summons.md#the-jesters-puppets). The puppet's strings: when the
// Jester falls, the puppet falls too; when the puppet falls, the Jester's Puppeteer starts
// its cooldown.

fn strings_label(owner: Character, fx: Effect): string { return "Puppet"; }

fn strings(jester: Character): Effect {
    fn should(owner: Character, fx: Effect, event: Event): bool {
        if (!fresh(owner, fx, event)) { return false; }
        match event.kind {
            EventKind.Fainted(c) => { return same(c, owner) || same(c, jester); }
            _ => { return false; }
        }
        return false;
    }
    fn react(owner: Character, fx: Effect, event: Event): List<Action> {
        var out: List<Action> = [];
        match event.kind {
            EventKind.Fainted(c) => {
                // The puppet's own fall from the Jester's knocks it out under this trigger, so this
                // trigger won't hear it: start the cooldown here.
                if (same(c, jester)) { out.push(Action.KnockOut(owner)); }
                out.push(Action.StartCooldown(jester, "Puppeteer", puppeteer_cooldown()));
            }
            _ => {}
        }
        return out;
    }
    var e = base("Strings", true);
    e.immune = true;
    e.should = should;
    e.react = react;
    e.label = strings_label;
    return e;
}
