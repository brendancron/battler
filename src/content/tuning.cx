fn thunderstorm_power(): int { return 18; }
fn thunderstorm_cooldown(): int { return 4; }
/** Chain Lightning's power on each foe, in the order they're picked. */
fn chain_lightning_powers(): List<int> { return [20, 15, 10, 5]; }
