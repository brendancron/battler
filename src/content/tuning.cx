/**
 * Every balance number for the characters' moves and passives, in one place.
 * They're all placeholders (docs/characters.md); change them here.
 *
 * Moves and effects read their numbers from these functions, and so do the
 * tests, which check what a move does in terms of its numbers rather than
 * repeating them. Tuning a number here never breaks a test.
 *
 * Powers go into the damage formula (docs/damage.md); percentages are of max
 * HP unless they say otherwise. Characters' attack, defense, tier and basic
 * attack power are in roster.cx.
 */

/**
 * The balance version these numbers are (docs/balance.md#versions). Bump it
 * with every balance change, here or in roster.cx: the balance checker keeps
 * each version's games apart, in balance-data/<version>/.
 */
fn balance_version(): string { return "v0.0.9"; }

// Barbarian

fn cleave_power(): int { return 30; }
fn cleave_cooldown(): int { return 2; }
/** Rage: attack × (c + a(1 − hp/max)^b). */
fn rage_c(): float { return 0.77; }
fn rage_a(): float { return 1.3; }
fn rage_b(): float { return 1.75; }

// Paladin

fn smite_power(): int { return 30; }
fn smite_cooldown(): int { return 2; }
/** Rounds of taunt with defense up. */
fn guard_rounds(): int { return 2; }
fn guard_cooldown(): int { return 4; }
/** Heals the ally this much, and the Paladin this much too. */
fn lay_on_hands_heal(): int { return 15; }
fn lay_on_hands_cooldown(): int { return 3; }
/** Last Rites: the ally comes back at this percent. */
fn last_rites_percent(): int { return 50; }

// Ranger

fn aimed_shot_power(): int { return 30; }
fn aimed_shot_cooldown(): int { return 2; }
/** Hunter's Mark: a hit of this power, then Marked for its rounds... */
fn hunters_mark_power(): int { return 15; }
fn hunters_mark_rounds(): int { return 2; }
/** ...making hits on the foe deal this percent more (its defense × 100 / (100 + this)). */
fn marked_percent(): int { return 30; }
fn hunters_mark_cooldown(): int { return 3; }
fn venom_arrow_power(): int { return 18; }
/** Poison Venom Arrow puts on the foe. */
fn venom_arrow_poison(): int { return 4; }
fn venom_arrow_cooldown(): int { return 2; }

// Cleric

fn prayer_heal(): int { return 20; }
fn prayer_cooldown(): int { return 4; }
fn purify_heal(): int { return 35; }
fn purify_cooldown(): int { return 3; }
fn sanctuary_heal(): int { return 20; }
fn sanctuary_cooldown(): int { return 3; }
fn resurrection_percent(): int { return 40; }
fn resurrection_cooldown(): int { return 7; }
/** Vigil: heals the lowest ally this much at round end. */
fn vigil_heal(): int { return 8; }

// Witch

fn brimstone_power(): int { return 25; }
/** Every ally heals this percent of the total damage dealt. */
fn brimstone_drain_percent(): int { return 17; }
fn brimstone_cooldown(): int { return 5; }
fn hex_cooldown(): int { return 4; }

// Alchemist

/** Panacea Mist: every ally heals this much, and gets a Panacea. */
fn panacea_mist_heal(): int { return 15; }
fn panacea_mist_cooldown(): int { return 3; }
/** Poison on each foe. */
fn acid_flask_poison(): int { return 6; }
fn acid_flask_cooldown(): int { return 4; }
/** Last Breath: no number; the ally stays up at 1 HP. */
fn last_breath_cooldown(): int { return 3; }
/** Energizer Potion (the Alchemist's in v0.0.7 and v0.0.8): each stack of Energized multiplies attack and defense by 100 + this, over 100. */
fn energizer_bonus_percent(): int { return 15; }
fn energizer_cooldown(): int { return 3; }
/** Energizer Potion also heals the ally this much. */
fn energizer_heal(): int { return 30; }
/** Greater Health Potion (the Alchemist's until v0.0.7). */
fn potion_heal(): int { return 45; }
/** The potion fires below this percent of max HP. */
fn potion_line_percent(): int { return 65; }
fn potion_cooldown(): int { return 3; }
/** Energize: the next attack gets this percent more attack. */
fn energize_bonus_percent(): int { return 75; }
fn energize_cooldown(): int { return 3; }

// Monk

fn disarming_palm_power(): int { return 20; }
/** Rounds of attack down and defense down. */
fn disarming_palm_rounds(): int { return 2; }
fn disarming_palm_cooldown(): int { return 2; }
fn crippling_blow_power(): int { return 20; }
/** The foe's own turns of Heal Block. */
fn crippling_blow_turns(): int { return 2; }
fn crippling_blow_cooldown(): int { return 2; }
fn flurry_power(): int { return 12; }
fn flurry_picks(): int { return 3; }
fn flurry_cooldown(): int { return 3; }

// Grim Reaper

fn reap_power(): int { return 30; }
/** Reap takes 1/this of its damage off max HP too. */
fn reap_wound_divisor(): int { return 3; }
fn reap_cooldown(): int { return 3; }
/** Spirit Link (the Shaman's until v0.0.9): the share of the Grim Reaper's damage that goes to the linked foe, and of the foe's healing that goes to the Grim Reaper. */
fn spirit_link_damage_percent(): int { return 50; }
fn spirit_link_heal_percent(): int { return 75; }
fn spirit_link_rounds(): int { return 2; }
fn spirit_link_cooldown(): int { return 3; }
/** Soul Siphon, the Grim Reaper's until v0.0.9 (no one has it now). */
fn soul_siphon_power(): int { return 25; }
/** Heals this percent of the HP the foe lost. */
fn soul_siphon_drain_percent(): int { return 50; }
fn soul_siphon_cooldown(): int { return 2; }
/** Soul Harvest: the Grim Reaper heals this much for each corpse it takes. */
fn soul_harvest_heal(): int { return 20; }

// Warlock

fn writhing_depths_power(): int { return 35; }
fn writhing_depths_cooldown(): int { return 5; }
fn final_offering_power(): int { return 45; }
fn final_offering_cooldown(): int { return 5; }

// Knight

fn shield_bash_power(): int { return 15; }
/** Rounds of taunt. */
fn shield_bash_rounds(): int { return 2; }
fn shield_bash_cooldown(): int { return 3; }
fn bulwark_shield(): int { return 30; }
fn bulwark_cooldown(): int { return 3; }

// Shaman

/** Attune: each stack of Attuned multiplies an ally's attack and defense by 100 + this, over 100. */
fn attune_bonus_percent(): int { return 25; }
fn attune_cooldown(): int { return 3; }
/** Healing Rain cleanses every ally, then heals each this much. */
fn healing_rain_heal(): int { return 30; }
fn healing_rain_cooldown(): int { return 4; }
fn totem_hp(): int { return 40; }
fn totem_defense(): int { return 32; }
/** The totem heals every ally this much at the end of each round while it stands. */
fn totem_heal(): int { return 5; }
/** Rounds the Totem move cools down once the totem is destroyed. */
fn totem_cooldown(): int { return 3; }

// Assassin

fn backstab_power(): int { return 36; }
fn backstab_cooldown(): int { return 3; }
fn execution_power(): int { return 20; }
fn execution_cooldown(): int { return 4; }
/** Predator: this percent more damage against a target below `predator_line_percent` of its max HP. */
fn predator_bonus_percent(): int { return 50; }
fn predator_line_percent(): int { return 75; }

// Bard

/** Overture: the team's attack goes up this percent in round 1... */
fn overture_percent(): int { return 30; }
/** ...and this much less at each round end, down to nothing. */
fn overture_fade_percent(): int { return 10; }
fn allegro_cooldown(): int { return 4; }
/** Rounds of Heckle's taunt and defense down on the foe. */
fn heckle_rounds(): int { return 2; }
fn heckle_cooldown(): int { return 4; }
/** Curtains reaches foes below this percent of their max HP. */
fn curtains_line_percent(): int { return 50; }
fn curtains_cooldown(): int { return 5; }
/** Largo (the Bard's until v0.0.9; no one has it now): rounds of attack down. */
fn largo_rounds(): int { return 2; }
fn largo_cooldown(): int { return 3; }
/** Crescendo (the Bard's passive until v0.0.9): each stack (a foe character fallen) adds this percent to the team's attack... */
fn crescendo_attack_percent(): int { return 17; }
/** ...and this percent to its defense. */
fn crescendo_defense_percent(): int { return 20; }

// Fairy

fn fairy_ring_cooldown(): int { return 7; }
/** Pixie Dust: a shield this big on every ally. */
fn pixie_dust_shield(): int { return 30; }
fn pixie_dust_cooldown(): int { return 4; }

// Necromancer

/** Death Throes: the Necromancer's parting hit on every foe standing. */
fn death_throes_power(): int { return 25; }
fn wither_power(): int { return 20; }
fn wither_cooldown(): int { return 4; }
fn raise_dead_cooldown(): int { return 5; }
fn skeleton_hp(): int { return 50; }
fn skeleton_attack(): int { return 100; }
fn skeleton_defense(): int { return 80; }
/** The skeleton's only move, its basic attack. */
fn bone_claw_power(): int { return 10; }

// Vampire

fn bite_power(): int { return 30; }
fn bite_cooldown(): int { return 2; }
/** Hemorrhage's bleed per round (it has no hit since v0.0.9), and for how many rounds. */
fn hemorrhage_bleed(): int { return 15; }
fn hemorrhage_rounds(): int { return 3; }
fn hemorrhage_cooldown(): int { return 3; }
/** Sanguine: heals this percent of the HP its damage takes off. */
fn sanguine_percent(): int { return 75; }
fn crimson_veil_power(): int { return 10; }
fn crimson_veil_cooldown(): int { return 3; }

// Cryomancer

fn blizzard_power(): int { return 20; }
fn blizzard_cooldown(): int { return 4; }
/** Icicle Barrage: this many picks, each a hit of this power and a chill. */
fn icicle_barrage_power(): int { return 10; }
fn icicle_barrage_picks(): int { return 3; }
fn icicle_barrage_cooldown(): int { return 3; }
/** Frostbite (the passive): damage to each chilled or frozen foe at every round end. */
fn frostbite_damage(): int { return 8; }
/** Cryosleep (the Frost Giant's until v0.0.9). */
fn cryosleep_heal(): int { return 15; }
fn cryosleep_cooldown(): int { return 4; }

// Frost Giant

fn avalanche_power(): int { return 19; }
fn avalanche_cooldown(): int { return 4; }
/** Rounds of taunt. */
fn glacial_roar_rounds(): int { return 2; }
fn glacial_roar_cooldown(): int { return 3; }

// Construct

fn piston_slam_power(): int { return 20; }
fn piston_slam_cooldown(): int { return 3; }
/** Rounds of attack down Piston Slam puts on the foe. */
fn piston_slam_rounds(): int { return 2; }
