fn trick_blade_cooldown(): int { return 2; }
/** A puppet rises at this percent of its max HP. */
fn puppet_percent(): int { return 25; }
/** Turns Puppeteer cools down once the puppet falls. */
fn puppeteer_cooldown(): int { return 5; }

// Shared: chill and freeze (docs/effects.md#chill-and-freeze)

/** Rounds a chill lasts. */
fn chill_rounds(): int { return 2; }

// Fatigue (docs/fatigue.md)

/** The first round that ends in fatigue. */
fn fatigue_from(): int { return 11; }
/** Max HP each character loses to fatigue per round. */
fn fatigue_loss(): int { return 10; }

// Shared effects

/** A shield loses this much at the end of every round. */
fn shield_decay(): int { return 20; }
