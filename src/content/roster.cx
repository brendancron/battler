import { Character, Effect, Tier, character } from "../core/creature";
import { MoveDef, basic_attack } from "../core/move";
import { rage, last_rites, keen_eye, vigil, inner_peace, soul_harvest, predator, panacea_supply, fae_bargain, sanguine, cold_aura, ironclad, shadowed, crescendo } from "effects";
import {
    cleave, smite, guard, lay_on_hands, aimed_shot, hunters_mark, venom_arrow, prayer, purify, sanctuary, brimstone, hex_move,
    acid_flask, energizer_potion, panacea_mist, disarming_palm, crippling_blow, flurry_of_blows,
    reap, soul_siphon, writhing_depths, shield_bash, bulwark, healing_rain, spirit_link, backstab, execution, resurrection, totem_move,
    final_offering, allegro, largo, fairy_ring, pixie_dust, wither, raise_dead, bite, hemorrhage, blizzard, frostbite,
    avalanche, glacial_roar, cryosleep_move, piston_slam, lockdown, overclock, thunderstorm, chain_lightning, shuriken, plunder, pistol_shot, en_garde,
    trick_blade, puppeteer
} from "moves";
import { bone_claw_power } from "tuning";

/**
 * A character ready for battle: its archetype (docs/archetypes.md), its stats
 * and passive, and the moves it can use, basic attack first. See
 * docs/characters.md and docs/moves.md.
 */
type Fighter { archetype: string, body: Character, moves: List<MoveDef> }

fn fighter(archetype: string, body: Character, passive: List<Effect>, moves: List<MoveDef>): Fighter {
    for (p in passive) {
        p.passive = true;
        body.effects.push(p);
    }
    return Fighter { archetype: archetype, body: body, moves: moves };
}

// Stats are placeholders until balancing.

fn barbarian(): Fighter { return fighter("Warrior", character("Barbarian", 125, 72, Tier.Normal), [rage()], [basic_attack("Axe Swing", 12), cleave()]); }

fn ranger(): Fighter { return fighter("Rogue", character("Ranger", 115, 55, Tier.Fast), [keen_eye()], [basic_attack("Quick Shot", 10), aimed_shot(), hunters_mark(), venom_arrow()]); }

fn cleric(): Fighter { return fighter("Support", character("Cleric", 67, 72, Tier.Normal), [vigil()], [basic_attack("Holy Spark", 8), prayer(), purify(), resurrection()]); }

fn paladin(): Fighter { return fighter("Tank", character("Paladin", 90, 156, Tier.Slow), [last_rites()], [basic_attack("Mace Strike", 8), smite(), guard(), lay_on_hands()]); }

fn grim_reaper(): Fighter { return fighter("Warrior", character("Grim Reaper", 115, 70, Tier.Slow), [soul_harvest()], [basic_attack("Scythe Slash", 10), reap(), soul_siphon()]); }

fn monk(): Fighter {
    return fighter("Warrior", character("Monk", 95, 60, Tier.Normal), [inner_peace()], [basic_attack("Jab", 10), disarming_palm(), crippling_blow(), flurry_of_blows()]);
}

fn witch(): Fighter { return fighter("Mage", character("Witch", 112, 48, Tier.Normal), [], [basic_attack("Curse Bolt", 10), brimstone(), hex_move()]); }

fn alchemist(): Fighter {
    return fighter("Support", character("Alchemist", 75, 80, Tier.Normal), [panacea_supply()], [basic_attack("Bottle Bash", 8), panacea_mist(), energizer_potion(), acid_flask()]);
}

fn warlock(): Fighter { return fighter("Mage", character("Warlock", 110, 45, Tier.Slow), [], [basic_attack("Void Bolt", 10), writhing_depths(), final_offering()]); }

fn knight(): Fighter { return fighter("Tank", character("Knight", 85, 140, Tier.Normal), [], [basic_attack("Sword Strike", 8), shield_bash(), bulwark()]); }

fn shaman(): Fighter { return fighter("Support", character("Shaman", 65, 50, Tier.Slow), [], [basic_attack("Spirit Strike", 8), healing_rain(), spirit_link(), totem_move()]); }

fn assassin(): Fighter {
    return fighter("Rogue", character("Assassin", 83, 52, Tier.Fast), [predator()], [basic_attack("Quick Cut", 10), backstab(), execution()]);
}

fn bard(): Fighter { return fighter("Support", character("Bard", 70, 75, Tier.Fast), [crescendo()], [basic_attack("Lute Strike", 8), allegro(), largo()]); }

fn fairy(): Fighter { return fighter("Support", character("Fairy", 65, 70, Tier.Fast), [fae_bargain()], [basic_attack("Pixie Bolt", 8), fairy_ring(), pixie_dust()]); }

fn necromancer(): Fighter { return fighter("Mage", character("Necromancer", 110, 60, Tier.Slow), [], [basic_attack("Bone Spike", 10), wither(), raise_dead()]); }

fn vampire(): Fighter { return fighter("Warrior", character("Vampire", 115, 62, Tier.Normal), [sanguine()], [basic_attack("Claw", 10), bite(), hemorrhage()]); }

fn cryomancer(): Fighter { return fighter("Mage", character("Cryomancer", 110, 55, Tier.Normal), [], [basic_attack("Ice Shard", 10), blizzard(), frostbite()]); }

fn frost_giant(): Fighter {
    return fighter("Tank", character("Frost Giant", 93, 150, Tier.Slow), [cold_aura()], [basic_attack("Frozen Fist", 8), avalanche(), glacial_roar(), cryosleep_move()]);
}

fn construct(): Fighter { return fighter("Tank", character("Construct", 75, 110, Tier.Fast), [ironclad()], [basic_attack("Gear Punch", 8), piston_slam(), lockdown(), overclock()]); }

fn stormbringer(): Fighter { return fighter("Mage", character("Stormbringer", 105, 50, Tier.Fast), [], [basic_attack("Spark", 10), thunderstorm(), chain_lightning()]); }

fn ninja(): Fighter { return fighter("Rogue", character("Ninja", 110, 50, Tier.Fast), [shadowed()], [basic_attack("Kunai", 10), shuriken()]); }

fn swashbuckler(): Fighter { return fighter("Warrior", character("Swashbuckler", 87, 68, Tier.Fast), [], [basic_attack("Cutlass", 10), pistol_shot(), plunder(), en_garde()]); }

fn jester(): Fighter { return fighter("Rogue", character("Jester", 94, 50, Tier.Fast), [], [basic_attack("Juggled Knife", 8), trick_blade(), puppeteer()]); }

/** Every character, in roster order. */
fn roster(): List<Fighter> {
    return [
        barbarian(), ranger(), warlock(), paladin(), cleric(), monk(), witch(), alchemist(), grim_reaper(), knight(), shaman(), assassin(),
        bard(), fairy(), necromancer(), vampire(), cryomancer(), frost_giant(), construct(), stormbringer(), ninja(), swashbuckler(), jester()
    ];
}

/**
 * The moves of a minion that takes turns, other than a puppet (which uses the
 * puppeted character's): the skeleton's basic attack. None for anything else.
 */
fn minion_moves(name: string): List<MoveDef> {
    if (name == "Skeleton") { return [basic_attack("Bone Claw", bone_claw_power())]; }
    return [];
}
