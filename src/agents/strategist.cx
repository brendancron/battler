import { async } from "std/async/Task";
import { Throw } from "std/core/Error";
import { Console, Stdin } from "std/io/Console";
import { IoError } from "std/io/Io";
import { Random, random_int } from "std/random/Random";
import { Character, Effect, Action } from "../core/creature";
import { Battle, Slot } from "../core/battle";
import { MoveDef } from "../core/move";
import { Choice, bind } from "../core/target";
import { Fighter } from "../content/roster";
import { foe_pick, roll } from "../game/draft";
import { Agent, Plan, Turn } from "agent";
import { Pick, best_adjusted, missing, shield_on, smaller } from "scoring";
import { scaling_worth, output, kit_of } from "tactician";

/**
 * Generation 3: plays like the Tactician, and counts what a cooldown costs.
 * Part of a move can go to waste: healing past max HP, or damage past what a
 * foe has left. Using it now means it can't be used for its cooldown, when
 * all of it might count, so the waste costs `waste × cooldown ÷ 4`. It holds
 * a team heal until the team is really hurt, and finishes a low foe with its
 * basic attack instead of a big hit. Drafts like Greedy. See
 * docs/balance.md#generations.
 */
type StrategistAgent;

impl Agent for StrategistAgent {
    fn choose_move(self, turn: Turn): <async, Console, Stdin, Random, Throw<IoError>> Option<Plan> {
        return Option.Some(strategist_action(turn.battle, turn.slot, turn.moves, turn.kits));
    }

    fn choose_pick(self, available: List<Fighter>, mine: List<Fighter>, theirs: List<Fighter>, pick: int): <async, Console, Stdin, Random, Throw<IoError>> int {
        return foe_pick(available, mine, roll);
    }
}

fn noise(n: int): int { return random_int(0, n + 1); }

/** The Strategist's move: the best move and target after the cooldown cost, with a little noise. */
fn strategist_action(battle: Battle, user: Slot, moveset: List<MoveDef>, kits: List<List<List<MoveDef>>>): Plan {
    match timed(battle, user, moveset, kits, 4, noise) {
        Option.Some(p) => { return Plan { slot: user, move: p.move, choice: p.choice }; }
        Option.None => { return Plan { slot: user, move: moveset[0], choice: Choice.NoTarget }; }
    }
    return Plan { slot: user, move: moveset[0], choice: Choice.NoTarget };
}

/** Each point of waste costs this many quarters per turn of cooldown (placeholder, tuned against the Tactician). */
fn waste_weight(): int { return 1; }

/**
 * The best move and target for the slot, the Strategist way: the Tactician's
 * scores, less each move's cooldown cost (`cooldown_cost`).
 */
fn timed<E>(battle: Battle, user: Slot, moveset: List<MoveDef>, kits: List<List<List<MoveDef>>>, jitter: int, noise: (int) -> <E> int): <E> Option<Pick> {
    fn revalue(c: Character, target: Character, fx: Effect): Option<int> {
        return scaling_worth(battle, c, target, fx, kits);
    }
    fn adjust(move: MoveDef, choice: Choice, score: int): int {
        return score - cooldown_cost(battle, user, move, choice) + kill_threat(battle, user, move, choice, kits);
    }
    return best_adjusted(battle, user, moveset, revalue, adjust, jitter, noise);
}

/** What using the move with the choice now costs: its waste, times its cooldown, times the weight ÷ 4. */
fn cooldown_cost(battle: Battle, user: Slot, move: MoveDef, choice: Choice): int {
    return wasted(battle, user, move, choice) * move.cooldown * waste_weight() / 4;
}

/** How much of the move would go to waste now: healing past max HP, and damage past what a foe has left. */
fn wasted(battle: Battle, user: Slot, move: MoveDef, choice: Choice): int {
    var c = battle.sides[user.side].active[user.index];
    match bind(move.shape, choice, battle, user) {
        Option.Some(target) => {
            var apply = move.apply;
            var total = 0;
            // Remembers who an earlier action cleansed, as the scores do.
            var cleansed: List<Character> = [];
            for (a in apply(battle, c, target)) {
                total = total + action_waste(c, a, cleansed);
                match a {
                    Action.Cleanse(t) => { cleansed.push(t); }
                    _ => {}
                }
            }
            return total;
        }
        Option.None => { return 0; }
    }
    return 0;
}

/** Damage past what the foe has left, HP and shield; none on an ally. */
fn overkill(user: Character, target: Character, amount: int): int {
    if (target.team == user.team || target.fainted()) { return 0; }
    var left = target.hp + shield_on(target);
    if (amount > left) { return amount - left; }
    return 0;
}

fn action_waste(user: Character, action: Action, cleansed: List<Character>): int {
    match action {
        Action.Heal(target, amount) => {
            if (target.team != user.team || target.fainted()) { return 0; }
            return amount - smaller(amount, missing(target, cleansed));
        }
        Action.Damage(target, _, amount, _) => { return overkill(user, target, amount); }
        Action.Drain(target, _, amount, _) => { return overkill(user, target, amount); }
        Action.AreaDrain(_, targets, amounts, _) => {
            var total = 0;
            var i = 0;
            while (i < targets.len()) {
                total = total + overkill(user, targets[i], amounts[i]);
                i = i + 1;
            }
            return total;
        }
        _ => { return 0; }
    }
    return 0;
}

/** A knockout is worth this many of the foe's best hits (placeholder, tuned against the Tactician). */
fn kill_weight(): int { return 3; }

/** The slot the character stands in, if it's on the field. */
fn slot_of(battle: Battle, c: Character): Option<Slot> {
    var side = 0;
    while (side < battle.sides.len()) {
        var i = 0;
        while (i < battle.sides[side].active.len()) {
            if (same(battle.sides[side].active[i], c)) { return Option.Some(Slot { side: side, index: i }); }
            i = i + 1;
        }
        side = side + 1;
    }
    return Option.None;
}

/** The scores give a flat 50 for knocking a foe out; this swaps it for the damage that foe would go on to deal. */
fn threat_of(battle: Battle, user: Character, target: Character, amount: int, kits: List<List<List<MoveDef>>>): int {
    if (target.team == user.team || target.fainted()) { return 0; }
    if (amount < target.hp + shield_on(target)) { return 0; }
    match slot_of(battle, target) {
        Option.Some(s) => { return output(battle, s, kit_of(kits, s)) * kill_weight() - 50; }
        Option.None => {}
    }
    return 0;
}

/** The change to the score from valuing each knockout by the foe's threat (`threat_of`). */
fn kill_threat(battle: Battle, user: Slot, move: MoveDef, choice: Choice, kits: List<List<List<MoveDef>>>): int {
    var c = battle.sides[user.side].active[user.index];
    match bind(move.shape, choice, battle, user) {
        Option.Some(target) => {
            var apply = move.apply;
            var total = 0;
            for (a in apply(battle, c, target)) {
                match a {
                    Action.Damage(t, _, amount, _) => { total = total + threat_of(battle, c, t, amount, kits); }
                    Action.Drain(t, _, amount, _) => { total = total + threat_of(battle, c, t, amount, kits); }
                    Action.AreaDrain(_, ts, amounts, _) => {
                        var i = 0;
                        while (i < ts.len()) {
                            total = total + threat_of(battle, c, ts[i], amounts[i], kits);
                            i = i + 1;
                        }
                    }
                    _ => {}
                }
            }
            return total;
        }
        Option.None => { return 0; }
    }
    return 0;
}
