import { async } from "std/async/Task";
import { Throw } from "std/core/Error";
import { Console, Stdin } from "std/io/Console";
import { IoError } from "std/io/Io";
import { Random, random_int } from "std/random/Random";
import { Character, Effect, EventKind, Cooldown, tier_rank } from "../core/creature";
import { Battle, Slot, Side, new_battle } from "../core/battle";
import { Engine, engine, announce } from "../core/engine";
import { MoveDef, use_move, turn_over, usable } from "../core/move";
import { Choice, bind } from "../core/target";
import { phases, begin_phase, next_actor } from "../core/order";
import { copy_effect } from "../content/effects";
import { Fighter } from "../content/roster";
import { foe_pick, roll } from "../game/draft";
import { Agent, Plan, Turn } from "agent";
import { Pick, choices, shield_on, as_is, best_by } from "scoring";
import { kit_of } from "tactician";

/**
 * Generation 4: looks ahead. For each move and target it could choose, it
 * plays the rest of the round out on a copy of the battle, everyone else
 * making their Greedy pick, then scores where that leaves the two sides:
 * standing characters, their HP and shields. It takes the move that leaves
 * its side furthest ahead. See docs/marshal.md.
 */
type MarshalAgent;

impl Agent for MarshalAgent {
    fn choose_move(self, turn: Turn): <async, Console, Stdin, Random, Throw<IoError>> Option<Plan> {
        return Option.Some(marshal_action(turn.battle, turn.slot, turn.moves, turn.kits));
    }

    fn choose_pick(self, available: List<Fighter>, mine: List<Fighter>, theirs: List<Fighter>, pick: int): <async, Console, Stdin, Random, Throw<IoError>> int {
        return foe_pick(available, mine, roll);
    }
}

fn noise(n: int): int { return random_int(0, n + 1); }

fn quiet(n: int): int { return 0; }

/** The Marshal's move: the one whose round played out ends best, with a little noise. */
fn marshal_action(battle: Battle, user: Slot, moveset: List<MoveDef>, kits: List<List<List<MoveDef>>>): Plan {
    match commanded(battle, user, moveset, kits, 4, noise) {
        Option.Some(p) => { return Plan { slot: user, move: p.move, choice: p.choice }; }
        Option.None => { return Plan { slot: user, move: moveset[0], choice: Choice.NoTarget }; }
    }
    return Plan { slot: user, move: moveset[0], choice: Choice.NoTarget };
}

/** Every usable move and target, each scored by playing the round out (`ahead`); the best, `jitter` noise added. */
fn commanded<E>(battle: Battle, user: Slot, moveset: List<MoveDef>, kits: List<List<List<MoveDef>>>, jitter: int, noise: (int) -> <E> int): <E> Option<Pick> {
    var c = battle.sides[user.side].active[user.index];
    var found: Option<Pick> = Option.None;
    var top = 0;
    for (m in moveset) {
        if (!usable(c, m)) { continue; }
        for (choice in choices(battle, user, m)) {
            match bind(m.shape, choice, battle, user) {
                Option.Some(_) => {
                    var total = ahead(battle, user, m, choice, kits);
                    if (jitter > 0) { total = total + noise(jitter); }
                    match found {
                        Option.Some(_) => {
                            if (total > top) { found = Option.Some(Pick { move: m, choice: choice, score: total }); top = total; }
                        }
                        Option.None => { found = Option.Some(Pick { move: m, choice: choice, score: total }); top = total; }
                    }
                }
                Option.None => {}
            }
        }
    }
    return found;
}

// Playing ahead on a copy.

/**
 * A copy of the battle to play ahead on: every character and effect copied,
 * a link's or a totem's partner pointing at the copy's character, nothing
 * recorded for the screen. Playing on it leaves the battle as it was.
 */
fn copy_battle(battle: Battle): Battle {
    var olds: List<Character> = [];
    var news: List<Character> = [];
    var sides: List<Side> = [];
    for (side in battle.sides) {
        var active: List<Character> = [];
        for (c in side.active) {
            var cooldowns: List<Cooldown> = [];
            for (k in c.cooldowns) { cooldowns.push(Cooldown { move: k.move, turns: k.turns }); }
            var n = Character {
                name: c.name, team: c.team, hp: c.hp, base_max_hp: c.base_max_hp, lost_max_hp: c.lost_max_hp,
                attack: c.attack, defense: c.defense, tier: c.tier, acted: c.acted, effects: [], cooldowns: cooldowns,
                corpse: c.corpse, allies: [], foes: []
            };
            olds.push(c);
            news.push(n);
            active.push(n);
        }
        sides.push(Side { active: active });
    }
    var i = 0;
    while (i < olds.len()) {
        for (e in olds[i].effects) {
            var copy = copy_effect(e);
            var partner: List<Character> = [];
            for (p in e.partner) {
                var j = 0;
                while (j < olds.len()) {
                    if (same(olds[j], p)) { partner.push(news[j]); }
                    j = j + 1;
                }
            }
            copy.partner = partner;
            news[i].effects.push(copy);
        }
        i = i + 1;
    }
    var b = new_battle(sides, battle.home);
    b.recording = false;
    return b;
}

fn over(battle: Battle): bool { return battle.defeated(0) || battle.defeated(1); }

/** One turn, as the game plays it: started, the move, ended, the cooldowns counted. */
fn take_turn(rules: Engine, battle: Battle, s: Slot, move: MoveDef, choice: Choice) {
    var c = battle.sides[s.side].active[s.index];
    announce(rules, battle, EventKind.TurnStarted(c));
    var used = use_move(rules, battle, s, move, choice);
    announce(rules, battle, EventKind.TurnEnded(c));
    if (used) { turn_over(c, Option.Some(move)); } else { turn_over(c, Option.None); }
    c.acted = true;
}

/** A turn the character loses (a Hex, a freeze): started and ended with nothing done. */
fn lose_turn(rules: Engine, battle: Battle, s: Slot) {
    var c = battle.sides[s.side].active[s.index];
    announce(rules, battle, EventKind.TurnStarted(c));
    announce(rules, battle, EventKind.TurnEnded(c));
    turn_over(c, Option.None);
    c.acted = true;
}

/**
 * The rest of the round from the phase `from` (a tier rank) on: everyone
 * still to act makes its Greedy pick, then the round ends (without fatigue,
 * which needs the round number).
 */
fn finish_round(rules: Engine, battle: Battle, kits: List<List<List<MoveDef>>>, from: int) {
    for (phase in phases()) {
        if (tier_rank(phase) < from) { continue; }
        var cursor = begin_phase(battle, phase);
        var going = true;
        while (going && !over(battle)) {
            match next_actor(battle, cursor) {
                Option.Some(s) => {
                    if (battle.sides[s.side].active[s.index].skips_turn()) {
                        lose_turn(rules, battle, s);
                    } else {
                        match best_by(battle, s, kit_of(kits, s), as_is, 0, quiet) {
                            Option.Some(p) => { take_turn(rules, battle, s, p.move, p.choice); }
                            Option.None => { battle.sides[s.side].active[s.index].acted = true; }
                        }
                    }
                }
                Option.None => { going = false; }
            }
        }
    }
    if (!over(battle)) { announce(rules, battle, EventKind.RoundEnded); }
}

/**
 * What a side has left: each standing character its HP, half its shield and
 * 60 for being in the fight; a minion half its HP and 10.
 */
fn standing(battle: Battle, side: int): int {
    var total = 0;
    for (c in battle.sides[side].active) {
        if (c.fainted()) { continue; }
        if (c.is_minion()) { total = total + c.hp / 2 + 10; }
        else { total = total + c.hp + shield_on(c) / 2 + 60; }
    }
    return total;
}

/**
 * How far ahead `user`'s side is once the move is made and the round played
 * out on a copy: what it has left less what the foes have, and 500 more for
 * a win (500 less for a loss).
 */
fn ahead(battle: Battle, user: Slot, move: MoveDef, choice: Choice, kits: List<List<List<MoveDef>>>): int {
    var copy = copy_battle(battle);
    var rules = engine();
    var from = tier_rank(copy.sides[user.side].active[user.index].current_tier());
    take_turn(rules, copy, user, move, choice);
    finish_round(rules, copy, kits, from);
    var score = standing(copy, user.side) - standing(copy, 1 - user.side);
    if (copy.defeated(1 - user.side)) { score = score + 500; }
    if (copy.defeated(user.side)) { score = score - 500; }
    return score;
}
