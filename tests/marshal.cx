import { Character, Action } from "battler/core/creature";
import { Battle, Slot } from "battler/core/battle";
import { MoveDef, basic_attack, damage } from "battler/core/move";
import { Choice } from "battler/core/target";
import { engine, perform } from "battler/core/engine";
import { Pick } from "battler/agents/scoring";
import { commanded, copy_battle, ahead } from "battler/agents/marshal";
import { shield, totem_spirit } from "battler/content/effects";
import { backstab } from "battler/content/moves";
import { duel, who, slot, sturdy } from "support";

// The Marshal (docs/marshal.md): it plays the round out on a copy for each choice.

fn none(n: int): int { return 0; }

fn jab(power: int): MoveDef { return basic_attack("Jab", power); }

fn target_of(p: Pick): int {
    match p.choice {
        Choice.Slots(slots) => { return slots[0].index; }
        Choice.NoTarget => { return -1; }
    }
    return -1;
}

fn marshal_pick(b: Battle, user: Slot, kits: List<List<List<MoveDef>>>): Pick {
    match commanded(b, user, kits[user.side][user.index], kits, 0, none) {
        Option.Some(p) => { return p; }
        Option.None => {}
    }
    assert(false, "no pick");
    return Pick { move: kits[0][0][0], choice: Choice.NoTarget, score: 0 };
}

@test
fn playing_ahead_leaves_the_battle_as_it_was() {
    var b = duel(["A", "B"], ["C", "D"]);
    who(b, slot(0, 1)).effects.push(shield(20));
    who(b, slot(1, 0)).effects.push(totem_spirit(who(b, slot(0, 0))));
    var kits = [[[jab(30)], [jab(30)]], [[jab(30)], [jab(30)]]];
    var before = b.log.len();
    var v = ahead(b, slot(0, 0), kits[0][0][0], Choice.Slots([slot(1, 0)]), kits);
    assert(who(b, slot(1, 0)).hp == 100 && who(b, slot(0, 1)).hp == 100, "nobody was hit");
    assert(b.log.len() == before && who(b, slot(0, 0)).cooldowns.len() == 0, "nothing logged, no cooldowns");
}

@test
fn a_copy_points_its_links_at_its_own_characters() {
    var b = duel(["Shaman"], ["Totem"]);
    who(b, slot(1, 0)).effects.push(totem_spirit(who(b, slot(0, 0))));
    var copy = copy_battle(b);
    var e = who(copy, slot(1, 0)).effects[0];
    assert(same(e.partner[0], who(copy, slot(0, 0))) && !same(e.partner[0], who(b, slot(0, 0))), "the copy's Shaman");
}

@test
fn the_marshal_finishes_the_foe_that_would_hit_hardest() {
    var b = duel(["Striker"], ["Big", "Small"]);
    sturdy(who(b, slot(0, 0)));
    who(b, slot(1, 0)).hp = 20;
    who(b, slot(1, 1)).hp = 20;
    // Both foes act after the Striker this round; knocking out the big hitter saves the most.
    var kits = [[[jab(30)]], [[jab(60)], [jab(5)]]];
    assert(target_of(marshal_pick(b, slot(0, 0), kits)) == 0, "the big hitter");
}

@test
fn the_marshal_finishes_a_foe_rather_than_spread_damage() {
    var b = duel(["Striker"], ["Hurt", "Fresh"]);
    sturdy(who(b, slot(0, 0)));
    who(b, slot(1, 0)).hp = damage(who(b, slot(0, 0)), who(b, slot(1, 0)), 30) - 1;
    var kits = [[[jab(30)]], [[jab(20)], [jab(20)]]];
    assert(target_of(marshal_pick(b, slot(0, 0), kits)) == 0, "the knockout");
}
