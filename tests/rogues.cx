import { Character, Action, EventKind, Tier, character } from "battler/core/creature";
import { Battle, Slot } from "battler/core/battle";
import { engine, perform, announce } from "battler/core/engine";
import { use_move, damage } from "battler/core/move";
import { Choice } from "battler/core/target";
import { shadowed, shroud, taunt, shield, attack_up, barrier, minion_marker, parry, on_guard, poison } from "battler/content/effects";
import { thunderstorm, chain_lightning, shuriken, shadow_strike, plunder, trick_blade, smite, pistol_shot, en_garde } from "battler/content/moves";
import { thunderstorm_power, chain_lightning_powers, shuriken_power, shadow_strike_power, plunder_power, trick_blade_power, trick_blade_silence_turns, pistol_shot_power, riposte_power } from "battler/content/tuning";
import { duel, who, slot, has_effect, sturdy } from "support";

// The Ninja (Shroud), the Stormbringer (Chain Lightning picks in order), and the Swashbuckler (steal).

fn add(b: Battle, fx: List<Action>) { perform(engine(), b, "test", fx); }

fn at(s: Slot): Choice { return Choice.Slots([s]); }

fn picks(slots: List<Slot>): Choice { return Choice.Slots(slots); }

fn pickable(b: Battle, from: Slot, s: Slot): bool {
    for (t in b.targetable_foes(from)) {
        if (t.side == s.side && t.index == s.index) { return true; }
    }
    return false;
}

// Ninja

@test
fn a_shrouded_ninja_cant_be_picked_while_an_ally_stands() {
    var b = duel(["A"], ["Ninja", "Ally"]);
    add(b, [Action.AddEffect(who(b, slot(1, 0)), shroud())]);
    assert(!pickable(b, slot(0, 0), slot(1, 0)) && pickable(b, slot(0, 0), slot(1, 1)), "only the ally");
    add(b, [Action.KnockOut(who(b, slot(1, 1)))]);
    assert(pickable(b, slot(0, 0), slot(1, 0)), "alone, it can be picked");
}

@test
fn area_moves_still_hit_a_shrouded_ninja() {
    var b = duel(["A"], ["Ninja", "Ally"]);
    add(b, [Action.AddEffect(who(b, slot(1, 0)), shroud())]);
    use_move(engine(), b, slot(0, 0), thunderstorm(), Choice.NoTarget);
    assert(who(b, slot(1, 0)).hp < 100, "hit");
}

@test
fn a_minion_keeps_the_ninja_hidden() {
    var b = duel(["A"], ["Ninja", "Skeleton"]);
    add(b, [Action.AddEffect(who(b, slot(1, 0)), shroud()), Action.AddEffect(who(b, slot(1, 1)), minion_marker(false))]);
    assert(!pickable(b, slot(0, 0), slot(1, 0)), "still hidden");
}

@test
fn a_shroud_lasts_until_its_holders_next_turn_starts() {
    var b = duel(["A"], ["Ninja", "Ally"]);
    var ninja = who(b, slot(1, 0));
    add(b, [Action.AddEffect(ninja, shroud())]);
    announce(engine(), b, EventKind.TurnStarted(who(b, slot(1, 1))));
    assert(!pickable(b, slot(0, 0), slot(1, 0)), "someone else's turn: still hidden");
    announce(engine(), b, EventKind.TurnStarted(ninja));
    assert(!has_effect(ninja, "Shroud") && pickable(b, slot(0, 0), slot(1, 0)), "its own turn: targeted as usual");
}

@test
fn shadowed_shrouds_the_ninja_at_the_start_of_the_battle_only() {
    var b = duel(["A"], ["Ninja", "Ally"]);
    var ninja = who(b, slot(1, 0));
    add(b, [Action.AddEffect(ninja, shadowed())]);
    announce(engine(), b, EventKind.RoundStarted);
    assert(has_effect(ninja, "Shroud"), "shrouded from the start");
    announce(engine(), b, EventKind.TurnStarted(ninja));
    announce(engine(), b, EventKind.RoundStarted);
    assert(!has_effect(ninja, "Shroud"), "not again the next round");
}

@test
fn shadow_strike_hits_and_shrouds_the_ninja_again() {
    var b = duel(["Ninja", "Ally"], ["B"]);
    var foe = who(b, slot(1, 0));
    sturdy(foe);
    var ninja = who(b, slot(0, 0));
    var d = damage(ninja, foe, shadow_strike_power());
    use_move(engine(), b, slot(0, 0), shadow_strike(), at(slot(1, 0)));
    assert(foe.hp == 1000 - d, "a hit");
    assert(has_effect(ninja, "Shroud") && !pickable(b, slot(1, 0), slot(0, 0)), "hidden again");
}

@test
fn a_shroud_can_be_stolen_once_the_ninja_can_be_picked() {
    var b = duel(["Swash", "Ally"], ["Ninja"]);
    var ninja = who(b, slot(1, 0));
    add(b, [Action.AddEffect(ninja, shroud())]);
    use_move(engine(), b, slot(0, 0), plunder(), at(slot(1, 0)));
    var swash = who(b, slot(0, 0));
    assert(!has_effect(ninja, "Shroud") && has_effect(swash, "Shroud"), "the Ninja stood alone, so Plunder took it");
    assert(!pickable(b, slot(1, 0), slot(0, 0)), "now the Swashbuckler hides behind its ally");
    announce(engine(), b, EventKind.TurnStarted(swash));
    assert(!has_effect(swash, "Shroud"), "until its own turn starts");
}

@test
fn shuriken_is_a_plain_hit() {
    var b = duel(["A"], ["B"]);
    var foe = who(b, slot(1, 0));
    sturdy(foe);
    var d = damage(who(b, slot(0, 0)), foe, shuriken_power());
    use_move(engine(), b, slot(0, 0), shuriken(), at(slot(1, 0)));
    assert(foe.hp == 1000 - d, "a hit");
}

@test
fn trick_blade_hits_and_silences_the_foe_for_its_turns() {
    var b = duel(["Jester"], ["Foe"]);
    var foe = who(b, slot(1, 0));
    sturdy(foe);
    var d = damage(who(b, slot(0, 0)), foe, trick_blade_power());
    use_move(engine(), b, slot(0, 0), trick_blade(), at(slot(1, 0)));
    assert(foe.hp == 1000 - d, "a hit");
    var n = 0;
    while (n < trick_blade_silence_turns()) {
        assert(foe.silenced(), "silenced");
        announce(engine(), b, EventKind.TurnEnded(foe));
        n = n + 1;
    }
    assert(!foe.silenced(), "then free");
}

// Stormbringer

@test
fn thunderstorm_hits_every_foe() {
    var b = duel(["Storm"], ["B", "C"]);
    var each = damage(who(b, slot(0, 0)), who(b, slot(1, 0)), thunderstorm_power());
    use_move(engine(), b, slot(0, 0), thunderstorm(), Choice.NoTarget);
    assert(who(b, slot(1, 0)).hp == 100 - each && who(b, slot(1, 1)).hp == 100 - each, "a hit on each");
}

@test
fn chain_lightning_hits_each_pick_with_the_next_power() {
    var b = duel(["Storm"], ["B", "C", "D", "E"]);
    var powers = chain_lightning_powers();
    var order: List<Slot> = [slot(1, 2), slot(1, 0), slot(1, 3), slot(1, 1)];
    var expected: List<int> = [];
    var i = 0;
    while (i < order.len()) {
        expected.push(damage(who(b, slot(0, 0)), who(b, order[i]), powers[i]));
        i = i + 1;
    }
    assert(use_move(engine(), b, slot(0, 0), chain_lightning(), picks(order)), "used");
    i = 0;
    while (i < order.len()) {
        assert(who(b, order[i]).hp == 100 - expected[i], "each bolt in turn");
        i = i + 1;
    }
}

@test
fn chain_lightning_cant_pick_a_foe_twice() {
    var b = duel(["Storm"], ["B", "C"]);
    assert(!use_move(engine(), b, slot(0, 0), chain_lightning(), picks([slot(1, 0), slot(1, 0)])), "a repeat");
}

@test
fn chain_lightning_stops_when_it_runs_out_of_foes() {
    var b = duel(["Storm"], ["B", "C"]);
    assert(!use_move(engine(), b, slot(0, 0), chain_lightning(), picks([slot(1, 0)])), "it must pick every foe it can");
    assert(use_move(engine(), b, slot(0, 0), chain_lightning(), picks([slot(1, 0), slot(1, 1)])), "two picks against two foes");
}

@test
fn chain_lightning_picks_a_taunter_first_and_a_shrouded_foe_last() {
    var b = duel(["Storm"], ["B", "Tank", "Ninja"]);
    add(b, [Action.AddEffect(who(b, slot(1, 1)), taunt(2)), Action.AddEffect(who(b, slot(1, 2)), shroud())]);
    assert(!use_move(engine(), b, slot(0, 0), chain_lightning(), picks([slot(1, 0), slot(1, 1), slot(1, 2)])), "the taunter must come first");
    assert(!use_move(engine(), b, slot(0, 0), chain_lightning(), picks([slot(1, 1), slot(1, 2), slot(1, 0)])), "the shrouded one must come last");
    assert(use_move(engine(), b, slot(0, 0), chain_lightning(), picks([slot(1, 1), slot(1, 0), slot(1, 2)])), "taunter, then the rest, then the shroud");
}

// Swashbuckler

@test
fn pistol_shot_reaches_past_a_taunt() {
    var b = duel(["Swashbuckler"], ["Tank", "Back"]);
    who(b, slot(1, 0)).effects.push(taunt(2));
    var back = who(b, slot(1, 1));
    var d = damage(who(b, slot(0, 0)), back, pistol_shot_power());
    assert(use_move(engine(), b, slot(0, 0), pistol_shot(), at(slot(1, 1))), "the one behind the taunt");
    assert(back.hp == 100 - d, "a hit");
}

@test
fn a_parry_blocks_the_next_direct_hit_and_ripostes() {
    var b = duel(["Swashbuckler"], ["Foe"]);
    var me = who(b, slot(0, 0));
    var foe = who(b, slot(1, 0));
    assert(use_move(engine(), b, slot(0, 0), en_garde(), Choice.NoTarget), "used");
    announce(engine(), b, EventKind.RoundEnded);
    announce(engine(), b, EventKind.TurnEnded(me));
    assert(has_effect(me, "Parry"), "it lasts until it's used");
    var back = damage(me, foe, riposte_power());
    add(b, [Action.Damage(me, Option.Some(foe), 40, true)]);
    assert(me.hp == 100 && foe.hp == 100 - back, "blocked, and the foe hit back");
    assert(!has_effect(me, "Parry"), "used up");
    add(b, [Action.Damage(me, Option.Some(foe), 40, true)]);
    assert(me.hp == 60, "the next hit lands");
}

@test
fn a_parry_doesnt_block_indirect_damage() {
    var b = duel(["Swashbuckler"], ["Foe"]);
    var me = who(b, slot(0, 0));
    me.effects.push(parry());
    add(b, [Action.Damage(me, Option.None, 10, false)]);
    assert(me.hp == 90 && has_effect(me, "Parry"), "poison and the like get through, and the parry waits");
}

@test
fn on_guard_is_one_parry_to_start_the_battle() {
    var b = duel(["Swashbuckler"], ["Foe"]);
    var me = who(b, slot(0, 0));
    var foe = who(b, slot(1, 0));
    me.effects.push(on_guard());
    add(b, [Action.Damage(me, Option.Some(foe), 40, true)]);
    assert(me.hp == 100 && foe.hp == 100 - damage(me, foe, riposte_power()), "the first hit is parried");
    add(b, [Action.Damage(me, Option.Some(foe), 40, true)]);
    assert(me.hp == 60 && has_effect(me, "On Guard"), "only once; the passive stays");
}

@test
fn plunder_steals_every_buff_then_hits() {
    var b = duel(["Swash"], ["B"]);
    var thief = who(b, slot(0, 0));
    var foe = who(b, slot(1, 0));
    add(b, [Action.AddEffect(foe, shield(30)), Action.AddEffect(foe, attack_up()), Action.AddEffect(foe, barrier())]);
    var expected = damage(thief, foe, plunder_power());
    use_move(engine(), b, slot(0, 0), plunder(), at(slot(1, 0)));
    assert(!has_effect(foe, "Shield") && !has_effect(foe, "Attack up") && !has_effect(foe, "Barrier"), "all gone from the foe");
    assert(has_effect(thief, "Shield") && has_effect(thief, "Attack up") && has_effect(thief, "Barrier"), "all on the Swashbuckler");
    assert(foe.hp == 100 - expected, "the hit landed: the shield and barrier went first");
}

@test
fn a_stolen_shield_adds_to_the_thiefs_own() {
    var b = duel(["Swash"], ["B"]);
    var thief = who(b, slot(0, 0));
    add(b, [Action.AddEffect(thief, shield(10)), Action.AddEffect(who(b, slot(1, 0)), shield(30))]);
    use_move(engine(), b, slot(0, 0), plunder(), at(slot(1, 0)));
    match thief.find_effect("Shield") {
        Option.Some(e) => { assert(e.power == 40, "added up"); }
        Option.None => { assert(false, "shielded"); }
    }
}

@test
fn passives_cant_be_stolen() {
    var b = duel(["Swash"], ["Ninja"]);
    var ninja = who(b, slot(1, 0));
    add(b, [Action.AddEffect(ninja, shadowed())]);
    use_move(engine(), b, slot(0, 0), plunder(), at(slot(1, 0)));
    assert(has_effect(ninja, "Shadowed") && !has_effect(who(b, slot(0, 0)), "Shadowed"), "it stays");
}

@test
fn plunder_steals_a_taunt() {
    var b = duel(["Swash"], ["Tank"]);
    add(b, [Action.AddEffect(who(b, slot(1, 0)), taunt(2))]);
    use_move(engine(), b, slot(0, 0), plunder(), at(slot(1, 0)));
    assert(!has_effect(who(b, slot(1, 0)), "Taunt") && who(b, slot(0, 0)).targeting_tier() > 0, "the Swashbuckler taunts now");
}

@test
fn smite_removes_a_taunt() {
    var b = duel(["Paladin"], ["Tank"]);
    add(b, [Action.AddEffect(who(b, slot(1, 0)), taunt(2))]);
    use_move(engine(), b, slot(0, 0), smite(), at(slot(1, 0)));
    assert(!has_effect(who(b, slot(1, 0)), "Taunt"), "taunt dispelled");
}
