import { page_path, data_path, data_script, stats_json } from "battler/balance/page";
import { Tier, character } from "battler/core/creature";

@test
fn the_page_and_its_data_sit_next_to_the_totals() {
    assert(page_path("balance.json") == "balance.html" && data_path("balance.json") == "balance.data.js", "json to html and data.js");
    assert(page_path("runs/alchemist.json") == "runs/alchemist.html", "keeps the folder");
    assert(page_path("totals") == "totals.html" && data_path("totals") == "totals.data.js", "no extension");
}

@test
fn the_data_script_sets_the_totals_the_stats_and_the_time() {
    assert(data_script("{\"games\": 4}", "{}", 1700000000) == "window.BALANCE_DATA = {\"games\": 4};\nwindow.BALANCE_STATS = {};\nwindow.BALANCE_WRITTEN = 1700000000;\n", "three assignments");
}

@test
fn the_stats_are_each_characters_attack_defense_archetype_and_tier() {
    var a = character("A", 120, 80, Tier.Normal);
    var b = character("B", 60, 150, Tier.Slow);
    assert(stats_json([a, b], ["Warrior", "Tank"]) == "{\"A\": [120, 80, \"Warrior\", \"Normal\"], \"B\": [60, 150, \"Tank\", \"Slow\"]}", "name to [attack, defense, archetype, tier]");
    assert(stats_json([], []) == "{}", "none");
}
