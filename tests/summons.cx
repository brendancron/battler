import { Character, Effect, Action, EventKind, Tier, character } from "battler/core/creature";
import { Battle, Slot } from "battler/core/battle";
import { engine, perform, announce } from "battler/core/engine";
import { MoveDef, use_move, usable, turn_over } from "battler/core/move";
import { Choice, has_targets } from "battler/core/target";
import { phases, start_round, begin_phase, next_actor } from "battler/core/order";
import { totem_move, new_totem, brimstone, prayer, cleave } from "battler/content/moves";
import { base } from "battler/content/effects";
import { totem_hp, totem_heal, totem_cooldown } from "battler/content/tuning";
import { duel, who, slot, logged, has_effect } from "support";

/** Shaman in slot 0 with an ally, against one foe, with the totem summoned into slot 2. */
fn with_totem(): Battle {
    var b = duel(["Shaman", "Ally"], ["Foe"]);
    use_move(engine(), b, slot(0, 0), totem_move(), Choice.NoTarget);
    return b;
}

fn totem(b: Battle): Character { return who(b, slot(0, 2)); }

@test
fn the_totem_joins_its_team_as_an_idle_minion() {
    var b = with_totem();
    assert(b.sides[0].active.len() == 3, "a third slot");
    var t = totem(b);
    assert(t.name == "Totem" && t.hp == totem_hp() && t.max_health() == totem_hp(), "full at its HP");
    assert(t.is_minion() && !t.takes_turns(), "an idle minion");
    assert(logged(b, "Shaman summoned a Totem (" + str(totem_hp()) + "/" + str(totem_hp()) + ")."), "logged");
}

fn end_round(b: Battle) { announce(engine(), b, EventKind.RoundEnded); }

@test
fn the_totem_taunts_so_foes_must_pick_it() {
    var b = with_totem();
    var picks = b.targetable_foes(slot(1, 0));
    assert(picks.len() == 1 && same_slot(picks[0], slot(0, 2)), "only the totem");
    assert(has_effect(totem(b), "Taunt"), "a taunt on the totem");
}

fn same_slot(a: Slot, b: Slot): bool { return a.side == b.side && a.index == b.index; }

@test
fn the_totem_heals_every_ally_at_the_end_of_each_round() {
    var b = with_totem();
    var shaman = who(b, slot(0, 0));
    var ally = who(b, slot(0, 1));
    shaman.take(50);
    ally.take(50);
    totem(b).take(totem_heal() + 1);
    end_round(b);
    assert(shaman.hp == 50 + totem_heal() && ally.hp == 50 + totem_heal(), "the allies, by its heal");
    assert(totem(b).hp == totem_hp() - 1, "the totem too");
    assert(who(b, slot(1, 0)).hp == 100, "not the foe");
    end_round(b);
    assert(ally.hp == 50 + 2 * totem_heal(), "again the next round");
}

@test
fn the_totems_taunt_and_heal_cant_be_dispelled_or_stolen() {
    var b = with_totem();
    perform(engine(), b, "test", [Action.Dispel(totem(b)), Action.Steal(totem(b), who(b, slot(1, 0)))]);
    assert(has_effect(totem(b), "Taunt") && has_effect(totem(b), "Mending"), "still on the totem");
    assert(!has_effect(who(b, slot(1, 0)), "Taunt"), "the foe took nothing");
}

// Auras (docs/effects.md#auras), on a test aura since the totem lost its own in v0.0.9.

fn aura_attack(owner: Character, fx: Effect, attack: int): int { return attack * 2; }

/** An aura doubling attack across its owner's team. */
fn doubling_aura(): Effect {
    var e = base("Banner", true);
    e.immune = true;
    e.aura = true;
    e.scale_attack = aura_attack;
    return e;
}

/** The Shaman's team, with the ally holding the doubling aura. */
fn with_aura(): Battle {
    var b = duel(["Shaman", "Ally"], ["Foe"]);
    perform(engine(), b, "test", [Action.AddEffect(who(b, slot(0, 1)), doubling_aura())]);
    return b;
}

@test
fn an_aura_reaches_the_whole_team_but_not_the_foes() {
    var b = with_aura();
    assert(who(b, slot(0, 0)).current_attack() == 200 && who(b, slot(0, 1)).current_attack() == 200, "both allies");
    assert(!has_effect(who(b, slot(0, 0)), "Banner"), "on its owner only");
    assert(who(b, slot(1, 0)).current_attack() == 100, "not the foe");
}

@test
fn an_aura_reaches_a_minion_summoned_later() {
    var b = with_aura();
    perform(engine(), b, "test", [Action.Summon(who(b, slot(0, 0)), character("Late", 100, 100, Tier.Normal))]);
    assert(who(b, slot(0, 2)).current_attack() == 200, "on arrival");
}

@test
fn an_aura_cant_be_dispelled_or_stolen() {
    var b = with_aura();
    perform(engine(), b, "test", [Action.Dispel(who(b, slot(0, 1))), Action.Steal(who(b, slot(0, 1)), who(b, slot(1, 0)))]);
    assert(who(b, slot(0, 0)).current_attack() == 200, "still there");
    assert(who(b, slot(1, 0)).current_attack() == 100, "the foe took nothing");
}

@test
fn two_of_the_same_aura_dont_stack() {
    var b = with_aura();
    perform(engine(), b, "test", [Action.AddEffect(who(b, slot(0, 0)), doubling_aura())]);
    assert(who(b, slot(0, 0)).current_attack() == 200, "doubled once");
}

@test
fn an_ally_resurrected_while_an_aura_stands_gets_it_again() {
    var b = with_aura();
    var shaman = who(b, slot(0, 0));
    perform(engine(), b, "test", [Action.Damage(shaman, Option.None, 200, false), Action.Resurrect(shaman, 50)]);
    assert(!shaman.fainted() && shaman.current_attack() == 200, "again");
}

@test
fn foes_can_target_the_totem_and_area_moves_hit_it() {
    var b = with_totem();
    assert(b.targetable_foes(slot(1, 0)).len() == 1, "the taunting totem");
    use_move(engine(), b, slot(1, 0), brimstone(), Choice.NoTarget);
    assert(totem(b).hp < totem_hp(), "Brimstone hit it");
}

@test
fn allies_can_heal_the_totem() {
    var b = with_totem();
    totem(b).take(totem_hp() - 1);
    use_move(engine(), b, slot(0, 1), prayer(), Choice.NoTarget);
    assert(totem(b).hp > 1, "Prayer reached it");
}

@test
fn destroying_the_totem_ends_its_taunt_and_heal_and_starts_the_cooldown() {
    var b = with_totem();
    var shaman = who(b, slot(0, 0));
    assert(shaman.cooldown_left("Totem") == 0, "no cooldown while it stands");
    perform(engine(), b, "test", [Action.Damage(totem(b), Option.None, 1000, false)]);
    assert(totem(b).fainted() && !totem(b).corpse, "destroyed, no corpse");
    assert(logged(b, "Totem was destroyed!"), "logged");
    assert(b.targetable_foes(slot(1, 0)).len() == 2, "no taunt: the foe can pick the Shaman or the ally");
    who(b, slot(0, 1)).take(50);
    end_round(b);
    assert(who(b, slot(0, 1)).hp == 50, "no heal");
    assert(shaman.cooldown_left("Totem") == totem_cooldown() && !usable(shaman, totem_move()), "cooling down");
    var i = 0;
    while (i < totem_cooldown()) { turn_over(shaman, Option.None); i = i + 1; }
    assert(usable(shaman, totem_move()), "ready after that many of the Shaman's turns");
}

@test
fn one_totem_at_a_time() {
    var b = with_totem();
    assert(!has_targets(b, slot(0, 0), totem_move().shape), "can't summon while one stands");
    assert(!use_move(engine(), b, slot(0, 0), totem_move(), Choice.NoTarget), "refused");
}

@test
fn a_new_totem_takes_the_old_ones_slot() {
    var b = with_totem();
    perform(engine(), b, "test", [Action.Damage(totem(b), Option.None, 1000, false)]);
    who(b, slot(0, 0)).cooldowns = [];
    assert(use_move(engine(), b, slot(0, 0), totem_move(), Choice.NoTarget), "summoned again");
    assert(b.sides[0].active.len() == 3 && totem(b).hp == totem_hp(), "same slot, fresh totem");
}

@test
fn the_totem_does_not_count_for_winning_or_losing() {
    var b = with_totem();
    perform(engine(), b, "test", [Action.Damage(who(b, slot(0, 0)), Option.None, 200, false), Action.Damage(who(b, slot(0, 1)), Option.None, 200, false)]);
    assert(!totem(b).fainted(), "the totem still stands");
    assert(b.defeated(0), "but the team has lost");
}

@test
fn the_totem_never_takes_a_turn() {
    var b = with_totem();
    start_round(b);
    var seen = 0;
    for (phase in phases()) {
        var cursor = begin_phase(b, phase);
        var going = true;
        while (going) {
            match next_actor(b, cursor) {
                Option.Some(s) => {
                    assert(!(s.side == 0 && s.index == 2), "not the totem");
                    b.sides[s.side].active[s.index].acted = true;
                    seen = seen + 1;
                }
                Option.None => { going = false; }
            }
        }
    }
    assert(seen == 3, "Shaman, Ally and Foe");
}

